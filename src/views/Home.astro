---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import collage from '../assets/save-the-date-collage.jpg';
import collagePortrait from '../assets/save-the-date-intro.jpg';
import denimTile from '../assets/denim-tile.jpg';
import { href, type Lang } from '../i18n';
import { t } from '../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

// Square collage on wide screens, the tall crop on portrait (phone) screens
const portraitQuery = '(max-aspect-ratio: 3/4)';
const square = await getImage({ src: collage, widths: [800, 1200, 2048], format: 'webp' });
const portrait = await getImage({ src: collagePortrait, widths: [450, 900], format: 'webp' });
// Mirrored patch of denim cut from the collage's corner; fills the sides on wide screens
const denim = await getImage({ src: denimTile, width: 1480, format: 'webp' });
---

<Base lang={lang} menu={false}>
  <section class="stage" style={`--denim: url(${denim.src})`}>
    <div class="frame">
      <picture>
        <source media={portraitQuery} srcset={portrait.srcSet.attribute} sizes="100vw" />
        <img
          src={square.src}
          srcset={square.srcSet.attribute}
          sizes="min(100vw, 100svh)"
          alt={c.home.collageAlt}
          width="2048"
          height="2048"
          fetchpriority="high"
        />
      </picture>
      <!-- blank paper laid over the handwriting, inside the letter's printed border -->
      <div class="letter">
        <p class="families">
          {
            c.home.families.map((f, i) => (
              <span class:list={['family', `family--${i + 1}`]}>
                {f.before && <span class="small">{f.before}</span>}
                <span class="family-name">{f.name}</span>
                {f.after && <span class="small">{f.after}</span>}
              </span>
            ))
          }
        </p>
        <p class="invite">{c.home.invite}</p>
        <h1 class="couple">{c.names}</h1>
        <p class="detail">{c.info.church}</p>
        <p class="detail">{c.info.date}</p>
      </div>
      <!-- the site's navigation on this page: paper cards tucked under the letter -->
      <nav class="cards" aria-label={c.nav.menu}>
        <a class="card card--details" href={href(lang, 'details')}><span>{c.nav.pages.details}</span></a>
        <a class="card card--registry" href={href(lang, 'registry')}><span>{c.nav.pages.registry}</span></a>
        <a class="tag" href="#rsvp" data-rsvp-open>
          <span class="tag-hole" aria-hidden="true"></span>
          {c.home.rsvp}
        </a>
      </nav>
    </div>
  </section>
</Base>

<style>
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    /* drawn at the same scale as the collage so the weave matches */
    background: #8ea2bb var(--denim) center / calc(min(100vw, 100svh) * 1480 / 2048) auto repeat;
  }

  .frame {
    position: relative;
    container-type: inline-size;
    width: min(100vw, 100svh);
    aspect-ratio: 1;
    /* where the handwritten lines sit on the letter, as % of the square collage */
    --letter-left: 35.2%;
    --letter-top: 34.2%;
    --letter-width: 30.7%;
    --letter-height: 47.1%;
    /* text scales with the collage; 1u = 1% of the collage's width */
    --u: 1cqw;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    mask-composite: intersect;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .letter {
    position: absolute;
    left: var(--letter-left);
    top: var(--letter-top);
    width: var(--letter-width);
    height: var(--letter-height);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 calc(var(--u) * 1.5);
    background: #fff;
    text-align: center;
    color: var(--color-ink);
  }
  .letter p {
    margin: 0;
  }

  /* "The Latreille and / Mathews families", staggered like a printed invitation */
  .families {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    margin-bottom: calc(var(--u) * 4) !important;
  }
  .family {
    display: flex;
    align-items: baseline;
    gap: calc(var(--u) * 0.8);
  }
  .family--1 {
    align-self: flex-start;
  }
  .family--2 {
    align-self: flex-end;
    margin-top: calc(var(--u) * 0.6);
  }
  .family-name {
    font-family: var(--font-headline);
    font-size: calc(var(--u) * 5.2);
    line-height: 1;
    color: var(--color-headline);
  }
  .small {
    font-size: calc(var(--u) * 1.3);
  }

  .invite {
    font-size: calc(var(--u) * 1.4);
  }
  .couple {
    margin: calc(var(--u) * 1.2) 0 calc(var(--u) * 3.4);
    font-family: var(--font-headline);
    font-size: calc(var(--u) * 3);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-headline);
  }
  .detail {
    font-size: calc(var(--u) * 1.35);
    line-height: 1.35;
  }
  .detail + .detail {
    margin-top: calc(var(--u) * 0.7);
  }

  /* Paper cards and the kraft tag overlapping the bottom of the letter, after the
     printed-ephemera collage on alilabelle.co. Each sits at its own angle (--r). */
  .cards {
    display: contents;
  }
  .card,
  .tag {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-family: var(--font-headline);
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    box-shadow: 0 calc(var(--u) * 0.5) calc(var(--u) * 1.2) rgba(0, 0, 0, 0.3);
    transform: rotate(var(--r));
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .card:hover,
  .tag:hover,
  .card:focus-visible,
  .tag:focus-visible {
    transform: rotate(calc(var(--r) * 0.6)) translateY(calc(var(--u) * -0.6)) scale(1.05);
    box-shadow: 0 calc(var(--u) * 0.9) calc(var(--u) * 1.8) rgba(0, 0, 0, 0.32);
  }

  .card {
    padding: calc(var(--u) * 0.7);
    font-size: calc(var(--u) * 2.4);
    /* faint paper grain */
    background-image: linear-gradient(170deg, rgba(255, 255, 255, 0.16), rgba(0, 0, 0, 0.05));
  }
  /* the double printed rule inside each card */
  .card span {
    display: block;
    padding: calc(var(--u) * 1) calc(var(--u) * 1.6) calc(var(--u) * 0.9);
    border: calc(var(--u) * 0.3) double currentColor;
  }
  .card--details {
    --x: 25.5%;
    --y: 77%;
    --r: -7deg;
    background-color: #8c9d6a;
    color: #22301a;
  }
  .card--registry {
    --x: 42%;
    --y: 80.5%;
    --r: 4deg;
    background-color: #ebe7c9;
    color: var(--color-headline);
  }
  .card--registry span {
    border-color: #3e3e3a;
  }

  /* kraft luggage tag that sat on the letter in the Wix version */
  .tag {
    --x: 60.5%;
    --y: 78.5%;
    --r: -18deg;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--u) * 0.8);
    padding: calc(var(--u) * 1) calc(var(--u) * 2.2) calc(var(--u) * 1) calc(var(--u) * 1.4);
    background: var(--color-kraft);
    background-image: linear-gradient(160deg, rgba(255, 255, 255, 0.18), rgba(0, 0, 0, 0.06));
    color: #2c2418;
    font-size: calc(var(--u) * 2.4);
    border-radius: calc(var(--u) * 0.6) calc(var(--u) * 1.8) calc(var(--u) * 1.8) calc(var(--u) * 0.6);
  }
  .tag-hole {
    width: calc(var(--u) * 0.9);
    height: calc(var(--u) * 0.9);
    border-radius: 50%;
    background: #e9e2d2;
    box-shadow: inset 0 0 0 calc(var(--u) * 0.2) #c9a24a;
  }

  @media (max-aspect-ratio: 3/4) {
    .frame {
      width: min(100vw, calc(100svh * 9 / 16));
      aspect-ratio: 9 / 16;
      --letter-left: 20.4%;
      --letter-top: 31.3%;
      --letter-width: 60%;
      --letter-height: 51.1%;
      --u: 2cqw;
    }
    .card--details {
      --x: 8%;
      --y: 84%;
    }
    .card--registry {
      --x: 36%;
      --y: 87%;
    }
    .tag {
      --x: 60%;
      --y: 84.5%;
    }
  }
</style>
