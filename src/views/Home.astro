---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import collage from '../assets/save-the-date-collage.jpg';
import collagePortrait from '../assets/save-the-date-intro.jpg';
import denimTile from '../assets/denim-tile.jpg';
import { href, type Lang } from '../i18n';
import { t } from '../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

// Square collage on wide screens, the tall crop on portrait (phone) screens
const portraitQuery = '(max-aspect-ratio: 3/4)';
const square = await getImage({ src: collage, widths: [800, 1200, 2048], format: 'webp' });
const portrait = await getImage({ src: collagePortrait, widths: [450, 900], format: 'webp' });
// Mirrored patch of denim cut from the collage's corner; fills the sides on wide screens
const denim = await getImage({ src: denimTile, width: 1480, format: 'webp' });
---

<Base lang={lang} menu={false}>
  <section class="stage" style={`--denim: url(${denim.src})`}>
    <div class="frame">
      <picture>
        <source media={portraitQuery} srcset={portrait.srcSet.attribute} sizes="100vw" />
        <img
          src={square.src}
          srcset={square.srcSet.attribute}
          sizes="min(100vw, 100svh)"
          alt={c.home.collageAlt}
          width="2048"
          height="2048"
          fetchpriority="high"
        />
      </picture>
      <!-- blank paper laid over the handwriting, inside the letter's printed border -->
      <div class="letter">
        <div class="letter-text">
        <p class="families">
          {
            c.home.families.map((f, i) => (
              <span class:list={['family', `family--${i + 1}`]}>
                {f.before && <span class="small">{f.before}</span>}
                <span class="family-name">{f.name}</span>
                {f.after && <span class="small">{f.after}</span>}
              </span>
            ))
          }
        </p>
        <p class="invite">{c.home.invite}</p>
        <h1 class="couple">{c.names}</h1>
        <p class="detail">{c.info.church}</p>
        <p class="detail">{c.info.date}</p>
        </div>
        <!-- the site's navigation on this page: a row of paper cards at the foot of the letter -->
        <!-- coloured as the flag of the language: Kenya in English, France in French -->
        <nav class="cards" aria-label={c.nav.menu} data-flag={lang}>
          <a class="card card--details" href={href(lang, 'details')}><span>{c.home.cards.details}</span></a>
          <a class="card card--registry" href={href(lang, 'registry')}><span>{c.home.cards.registry}</span></a>
          <a class="card card--rsvp" href="#rsvp" data-rsvp-open><span>{c.home.rsvp}</span></a>
        </nav>
      </div>
    </div>
  </section>
</Base>

<style>
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    /* drawn at the same scale as the collage so the weave matches */
    background: #8ea2bb var(--denim) center / calc(min(100vw, 100svh) * 1480 / 2048) auto repeat;
  }

  .frame {
    position: relative;
    container-type: inline-size;
    width: min(100vw, 100svh);
    aspect-ratio: 1;
    /* where the handwritten lines sit on the letter, as % of the square collage */
    --letter-left: 35.2%;
    --letter-top: 34.2%;
    --letter-width: 30.7%;
    --letter-height: 47.1%;
    /* text scales with the collage; 1u = 1% of the collage's width */
    --u: 1cqw;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    mask-composite: intersect;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .letter {
    position: absolute;
    left: var(--letter-left);
    top: var(--letter-top);
    width: var(--letter-width);
    height: var(--letter-height);
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #fff;
    text-align: center;
    color: var(--color-ink);
  }
  .letter p {
    margin: 0;
  }
  .letter-text {
    flex: 1;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 calc(var(--u) * 1.5);
  }

  /* "The Latreille and / Mathews families", staggered like a printed invitation */
  .families {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    margin-bottom: calc(var(--u) * 4) !important;
  }
  .family {
    display: flex;
    align-items: baseline;
    gap: calc(var(--u) * 0.8);
  }
  .family--1 {
    align-self: flex-start;
  }
  .family--2 {
    align-self: flex-end;
    margin-top: calc(var(--u) * 0.6);
  }
  .family-name {
    font-family: var(--font-headline);
    font-size: calc(var(--u) * 5.2);
    line-height: 1;
    color: var(--color-headline);
  }
  .small {
    font-size: calc(var(--u) * 1.3);
  }

  .invite {
    font-size: calc(var(--u) * 1.4);
  }
  .couple {
    margin: calc(var(--u) * 1.2) 0 calc(var(--u) * 3.4);
    font-family: var(--font-headline);
    font-size: calc(var(--u) * 3);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-headline);
  }
  .detail {
    font-size: calc(var(--u) * 1.35);
    line-height: 1.35;
  }
  .detail + .detail {
    margin-top: calc(var(--u) * 0.7);
  }

  /* Three paper cards in a row at the foot of the letter, inside its
     printed border, after the printed ephemera on alilabelle.co. Each one is tilted
     (--r) and nudged up or down (--dy) a little so they look casually laid down. */
  .cards {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: calc(var(--u) * 1.1);
    padding: calc(var(--u) * 0.8) 0 calc(var(--u) * 1.3);
  }
  .card {
    display: flex;
    align-items: center;
    padding: calc(var(--u) * 0.4);
    background-color: var(--card-bg);
    /* faint paper grain */
    background-image: linear-gradient(170deg, rgba(255, 255, 255, 0.16), rgba(0, 0, 0, 0.05));
    color: var(--card-ink);
    font-family: var(--font-headline);
    font-size: calc(var(--u) * 1.42);
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    box-shadow: 0 calc(var(--u) * 0.3) calc(var(--u) * 0.8) rgba(0, 0, 0, 0.22);
    transform: translateY(var(--dy)) rotate(var(--r));
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(calc(var(--dy) - var(--u) * 0.4)) rotate(calc(var(--r) * 0.5));
    box-shadow: 0 calc(var(--u) * 0.7) calc(var(--u) * 1.4) rgba(0, 0, 0, 0.26);
  }
  /* the double printed rule inside each card */
  .card span {
    display: flex;
    align-items: center;
    height: 100%;
    padding: calc(var(--u) * 0.7) calc(var(--u) * 0.9);
    border: calc(var(--u) * 0.22) double var(--card-rule, currentColor);
  }

  /* each card's tilt (--r) and nudge up or down (--dy) */
  .card--details {
    --r: -4deg;
    --dy: calc(var(--u) * -0.3);
  }
  .card--registry {
    --r: 2.5deg;
    --dy: calc(var(--u) * 0.4);
  }
  .card--rsvp {
    --r: -6deg;
    --dy: calc(var(--u) * -0.1);
  }

  /* English: the Kenyan flag, black, red, green (with cream rules for its white bands);
     French: the French flag, blue, white, red. Colours live in global.css. */
  [data-flag='en'] .card--details {
    --card-bg: var(--ke-black);
    --card-ink: var(--ke-black-ink);
  }
  [data-flag='en'] .card--registry {
    --card-bg: var(--ke-red);
    --card-ink: var(--ke-red-ink);
  }
  [data-flag='en'] .card--rsvp {
    --card-bg: var(--ke-green);
    --card-ink: var(--ke-green-ink);
  }
  [data-flag='fr'] .card--details {
    --card-bg: var(--fr-blue);
    --card-ink: var(--fr-blue-ink);
  }
  [data-flag='fr'] .card--registry {
    --card-bg: var(--fr-white);
    --card-ink: var(--fr-white-ink);
    --card-rule: var(--fr-white-rule);
  }
  [data-flag='fr'] .card--rsvp {
    --card-bg: var(--fr-red);
    --card-ink: var(--fr-red-ink);
  }

  @media (max-aspect-ratio: 3/4) {
    .frame {
      width: min(100vw, calc(100svh * 9 / 16));
      aspect-ratio: 9 / 16;
      --letter-left: 20.4%;
      --letter-top: 31.3%;
      --letter-width: 60%;
      --letter-height: 51.1%;
      --u: 2cqw;
    }
  }
</style>
