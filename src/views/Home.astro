---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import collage from '../assets/save-the-date-collage.jpg';
import collagePortrait from '../assets/save-the-date-intro.jpg';
import denimTile from '../assets/denim-tile.jpg';
import { type Lang } from '../i18n';
import { t } from '../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

// Square collage on wide screens, the tall crop on portrait (phone) screens
const portraitQuery = '(max-aspect-ratio: 3/4)';
const square = await getImage({ src: collage, widths: [800, 1200, 2048], format: 'webp' });
const portrait = await getImage({ src: collagePortrait, widths: [450, 900], format: 'webp' });
// Mirrored patch of denim cut from the collage's corner; fills the sides on wide screens
const denim = await getImage({ src: denimTile, width: 1480, format: 'webp' });
---

<Base lang={lang}>
  <section class="stage" style={`--denim: url(${denim.src})`}>
    <div class="frame">
      <picture>
        <source media={portraitQuery} srcset={portrait.srcSet.attribute} sizes="100vw" />
        <img
          src={square.src}
          srcset={square.srcSet.attribute}
          sizes="min(100vw, 100svh)"
          alt={c.home.collageAlt}
          width="2048"
          height="2048"
          fetchpriority="high"
        />
      </picture>
      <!-- blank paper laid over the handwriting, inside the letter's printed border -->
      <div class="letter">
        <p class="families">
          {
            c.home.families.map((f, i) => (
              <span class:list={['family', `family--${i + 1}`]}>
                {f.before && <span class="small">{f.before}</span>}
                <span class="family-name">{f.name}</span>
                {f.after && <span class="small">{f.after}</span>}
              </span>
            ))
          }
        </p>
        <p class="invite">{c.home.invite}</p>
        <h1 class="couple">{c.names}</h1>
        <p class="detail">{c.info.church}</p>
        <p class="detail">{c.info.date}</p>
      </div>
      <a class="tag" href="#rsvp" data-rsvp-open>
        <span class="tag-hole" aria-hidden="true"></span>
        {c.home.rsvp}
      </a>
    </div>
  </section>
</Base>

<style>
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    /* drawn at the same scale as the collage so the weave matches */
    background: #8ea2bb var(--denim) center / calc(min(100vw, 100svh) * 1480 / 2048) auto repeat;
  }

  .frame {
    position: relative;
    container-type: inline-size;
    width: min(100vw, 100svh);
    aspect-ratio: 1;
    /* where the handwritten lines sit on the letter, as % of the square collage */
    --letter-left: 35.2%;
    --letter-top: 34.2%;
    --letter-width: 30.7%;
    --letter-height: 47.1%;
    /* text scales with the collage; 1u = 1% of the collage's width */
    --u: 1cqw;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    mask-composite: intersect;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .letter {
    position: absolute;
    left: var(--letter-left);
    top: var(--letter-top);
    width: var(--letter-width);
    height: var(--letter-height);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 calc(var(--u) * 1.5);
    background: #fff;
    text-align: center;
    color: var(--color-ink);
  }
  .letter p {
    margin: 0;
  }

  /* "The Latreille and / Mathews families", staggered like a printed invitation */
  .families {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    margin-bottom: calc(var(--u) * 4) !important;
  }
  .family {
    display: flex;
    align-items: baseline;
    gap: calc(var(--u) * 0.8);
  }
  .family--1 {
    align-self: flex-start;
  }
  .family--2 {
    align-self: flex-end;
    margin-top: calc(var(--u) * 0.6);
  }
  .family-name {
    font-family: var(--font-headline);
    font-size: calc(var(--u) * 5.2);
    line-height: 1;
    color: var(--color-headline);
  }
  .small {
    font-size: calc(var(--u) * 1.3);
  }

  .invite {
    font-size: calc(var(--u) * 1.4);
  }
  .couple {
    margin: calc(var(--u) * 1.2) 0 calc(var(--u) * 3.4);
    font-family: var(--font-headline);
    font-size: calc(var(--u) * 3);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-headline);
  }
  .detail {
    font-size: calc(var(--u) * 1.35);
    line-height: 1.35;
  }
  .detail + .detail {
    margin-top: calc(var(--u) * 0.7);
  }

  /* kraft luggage tag that sat on the letter in the Wix version */
  .tag {
    position: absolute;
    left: 64%;
    top: 81%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px 10px 14px;
    background: var(--color-kraft);
    background-image: linear-gradient(160deg, rgba(255, 255, 255, 0.18), rgba(0, 0, 0, 0.06));
    color: #2c2418;
    font: 600 clamp(13px, 1.8vmin, 18px) / 1 var(--font-sans);
    letter-spacing: 0.14em;
    text-decoration: underline;
    text-underline-offset: 3px;
    border-radius: 6px 18px 18px 6px;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.28);
    transform: rotate(-22deg);
    transition: transform 0.3s ease;
  }
  .tag:hover {
    transform: rotate(-16deg) scale(1.06);
  }
  .tag-hole {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #e9e2d2;
    box-shadow: inset 0 0 0 2px #c9a24a;
  }

  @media (max-aspect-ratio: 3/4) {
    .frame {
      width: min(100vw, calc(100svh * 9 / 16));
      aspect-ratio: 9 / 16;
      --letter-left: 20.4%;
      --letter-top: 31.3%;
      --letter-width: 60%;
      --letter-height: 51.1%;
      --u: 2cqw;
    }
    .tag {
      left: 34%;
      top: 88%;
    }
  }
</style>
