---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import collage from '../assets/save-the-date-collage.jpg';
import collagePortrait from '../assets/save-the-date-intro.jpg';
import denimTile from '../assets/denim-tile.jpg';
import { href, type Lang } from '../i18n';
import { t } from '../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

// Square collage on wide screens, the tall crop on portrait (phone) screens
const portraitQuery = '(max-aspect-ratio: 3/4)';
const square = await getImage({ src: collage, widths: [800, 1200, 2048], format: 'webp' });
const portrait = await getImage({ src: collagePortrait, widths: [450, 900], format: 'webp' });
// Mirrored patch of denim cut from the collage's corner; fills the sides on wide screens
const denim = await getImage({ src: denimTile, width: 1480, format: 'webp' });
---

<Base lang={lang}>
  <h1 class="sr-only">{c.names}</h1>
  <section class="stage" style={`--denim: url(${denim.src})`}>

    <div class="frame">
      <picture>
        <source media={portraitQuery} srcset={portrait.srcSet.attribute} sizes="100vw" />
        <img
          src={square.src}
          srcset={square.srcSet.attribute}
          sizes="min(100vw, 100svh)"
          alt={c.home.collageAlt}
          width="2048"
          height="2048"
          fetchpriority="high"
        />
      </picture>
      <a class="tag" href={href(lang, 'rsvp')}>
        <span class="tag-hole" aria-hidden="true"></span>
        {c.home.rsvp}
      </a>
    </div>
  </section>
</Base>

<style>
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    /* drawn at the same scale as the collage so the weave matches */
    background: #8ea2bb var(--denim) center / calc(min(100vw, 100svh) * 1480 / 2048) auto repeat;
  }

  .frame {
    position: relative;
    width: min(100vw, 100svh);
    aspect-ratio: 1;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    mask-composite: intersect;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* kraft luggage tag that sat on the letter in the Wix version */
  .tag {
    position: absolute;
    left: 64%;
    top: 81%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px 10px 14px;
    background: var(--color-kraft);
    background-image: linear-gradient(160deg, rgba(255, 255, 255, 0.18), rgba(0, 0, 0, 0.06));
    color: #2c2418;
    font: 600 clamp(13px, 1.8vmin, 18px) / 1 var(--font-sans);
    letter-spacing: 0.14em;
    text-decoration: underline;
    text-underline-offset: 3px;
    border-radius: 6px 18px 18px 6px;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.28);
    transform: rotate(-22deg);
    transition: transform 0.3s ease;
  }
  .tag:hover {
    transform: rotate(-16deg) scale(1.06);
  }
  .tag-hole {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #e9e2d2;
    box-shadow: inset 0 0 0 2px #c9a24a;
  }

  @media (max-aspect-ratio: 3/4) {
    .frame {
      width: min(100vw, calc(100svh * 9 / 16));
      aspect-ratio: 9 / 16;
    }
    .tag {
      left: 34%;
      top: 88%;
    }
  }
</style>
