---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { type Lang } from '../i18n';
import { t } from '../content';
import { CONTACT_EMAIL } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).faqs;
---

<Base lang={lang} title={c.title}>
  <div class="page">
    <div class="column">
      <PageHead title={c.title} intro={c.intro} vignette="letter" />

      <div class="faqs" data-reveal>
        {
          c.items.map((item) => (
            <details>
              <summary>
                <span>{item.q}</span>
                <span class="icon" aria-hidden="true" />
              </summary>
              <p class="muted">{item.a}</p>
            </details>
          ))
        }
      </div>

      <p class="contact" data-reveal>
        <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </div>
  </div>
</Base>

<style>
  details {
    border-top: 1px solid var(--color-rule);
  }
  details:last-child {
    border-bottom: 1px solid var(--color-rule);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .icon {
    flex: none;
    position: relative;
    width: 14px;
    height: 14px;
  }
  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6.5px;
    width: 14px;
    height: 1px;
    background: currentColor;
    transition: transform 0.25s ease;
  }
  .icon::after {
    transform: rotate(90deg);
  }
  details[open] .icon::after {
    transform: rotate(0);
  }
  details p {
    margin: -6px 0 22px;
    padding-right: 30px;
  }
  .contact {
    text-align: center;
    margin-top: 40px;
  }
</style>
