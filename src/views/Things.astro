---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { type Lang } from '../i18n';
import { t } from '../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).things;
const mapUrl = (place: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place + ', Ardèche')}`;
---

<Base lang={lang} title={c.title}>
  <div class="page">
    <div class="column">
      <PageHead title={c.title} intro={c.intro} vignette="canoe" />

      <ol class="places">
        {
          c.items.map((item, i) => (
            <li data-reveal>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2>{item.title}</h2>
                <p class="muted">{item.note}</p>
                <a class="text-link" href={item.link ?? mapUrl(item.title)} target="_blank" rel="noopener">
                  {c.mapLink} ↗
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Base>

<style>
  .places {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .places li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 8px;
    padding: 28px 0;
    border-top: 1px solid var(--color-rule);
  }
  .places li:last-child {
    border-bottom: 1px solid var(--color-rule);
  }
  .num {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 300;
    color: var(--color-ink-muted);
    padding-top: 4px;
  }
  h2 {
    font-size: 1.6rem;
    margin-bottom: 8px;
  }
  .places p {
    margin-bottom: 6px;
  }
</style>
