---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import Arrow from '../components/Arrow.astro';
import RuleList from '../components/RuleList.astro';
import recatadou from '../assets/illus-recatadou.png';
import church from '../assets/illus-church-street.jpg';
import denimTile from '../assets/denim-tile.jpg';
import { type Lang } from '../i18n';
import { t } from '../content';
import { MAPS } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = t(lang);
const c = all.info;
// the same denim as the home page, behind the paper sheets
const denim = await getImage({ src: denimTile, width: 1480, format: 'webp' });
---

<Base lang={lang} title={c.title}>
  <!-- Each section is a sheet of paper on the denim; each sheet after the first has a
       flag-coloured card label tucked over its top edge, coloured like the home buttons -->
  <div class="desk" style={`--denim: url(${denim.src})`} data-flag={lang}>
  <section class="sheet intro" style="--tilt: -0.5deg">
    <figure class="church">
      <Image
        src={church}
        alt="Watercolour of the stone steps in L’Argentiere climbing to the church spire, past Josephine’s grandparents’ house"
        widths={[640, 1024]}
        sizes="(max-width: 900px) 100vw, 900px"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="note note--ceremony">
        <span>{c.notes.ceremony[0]}<br />{c.notes.ceremony[1]}</span>
        <Arrow transform="scaleX(-1)" />
      </figcaption>
      <p class="note note--grandparents">
        <Arrow transform="rotate(180deg)" />
        <span>{c.notes.grandparents[0]}<br />{c.notes.grandparents[1]}</span>
      </p>
    </figure>

    <div class="title">
      <h1>{all.names}</h1>
      <p>{c.church}</p>
      <p>{c.date}</p>
      <a class="rsvp-pill" href="#rsvp" data-rsvp-open>{c.rsvp}</a>
    </div>

    <figure class="reception" data-reveal>
      <Image
        src={recatadou}
        alt="Watercolour of the Salle du Recatadou: a stone house on a clifftop above the Ardèche gorge"
        widths={[560, 1048]}
        sizes="(max-width: 760px) 84vw, 640px"
      />
      <figcaption class="note note--reception">
        <span>{c.notes.reception[0]}<br />{c.notes.reception[1]}</span>
        <Arrow transform="rotate(10deg)" />
      </figcaption>
    </figure>
  </section>

  <section class="sheet" id="venues" style="--tilt: 0.6deg" aria-labelledby="venues-title">
    <h2 class="label label--1" id="venues-title" style="--r: -3deg"><span>{c.venuesTitle}</span></h2>
    <div class="venue-grid">
      <article class="venue" data-reveal>
        <p class="eyebrow">{c.ceremony.label}</p>
        <h3>{c.ceremony.name}</h3>
        <p class="muted">{c.ceremony.town}</p>
        <a class="text-link" href={MAPS.ceremony} target="_blank" rel="noopener">{c.directions} ↗</a>
      </article>
      <article class="venue" data-reveal>
        <p class="eyebrow">{c.reception.label}</p>
        <h3>{c.reception.name}</h3>
        <p class="muted">{c.reception.town}</p>
        <a class="text-link" href={MAPS.reception} target="_blank" rel="noopener">{c.directions} ↗</a>
      </article>
    </div>
  </section>

  <section class="sheet" id="schedule" style="--tilt: -0.4deg" aria-labelledby="schedule-title">
    <h2 class="label label--2" id="schedule-title" style="--r: 2deg"><span>{all.timings.title}</span></h2>
    <div class="column">
      <ol class="timeline">
        {
          all.timings.items.map((item) => (
            <li data-reveal>
              <span class="time">{item.time}</span>
              <span class="dot" aria-hidden="true" />
              <div>
                <h3>{item.title}</h3>
                <p class="muted">{item.place}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="timeline-note muted" data-reveal>{all.timings.transportNote}</p>
    </div>
  </section>

  <section class="sheet" id="travel" style="--tilt: 0.5deg" aria-labelledby="travel-title">
    <h2 class="label label--3" id="travel-title" style="--r: -2deg"><span>{all.travel.title}</span></h2>
    <div class="column">
      <div class="sub" data-reveal>
        <p class="eyebrow">{all.travel.gettingEyebrow}</p>
        <h3 class="sub-title">{all.travel.gettingTitle}</h3>
        <p class="muted">{all.travel.gettingIntro}</p>
        {
          all.travel.getting.map((g) => (
            <>
              <h4 class="group-label">{g.label}</h4>
              <RuleList entries={g.entries} />
            </>
          ))
        }
      </div>

      <div class="sub" data-reveal>
        <p class="eyebrow">{all.travel.stayEyebrow}</p>
        <h3 class="sub-title">{all.travel.stayTitle}</h3>
        <p class="muted">{all.travel.stayIntro}</p>
        {
          all.travel.stay.map((g) => (
            <>
              <h4 class="group-label">{g.label}</h4>
              <RuleList entries={g.entries} />
            </>
          ))
        }
        <p class="muted outro">{all.travel.stayOutro}</p>
      </div>
    </div>
  </section>

  <section class="sheet" id="qa" style="--tilt: -0.3deg" aria-labelledby="qa-title">
    <h2 class="label label--1" id="qa-title" style="--r: 3deg"><span>{all.faqs.title}</span></h2>
    <div class="column">
      <p class="sheet-intro muted">{all.faqs.intro}</p>
      <div data-reveal>
        <FaqList items={all.faqs.items} />
      </div>
    </div>
  </section>
  </div>
</Base>

<style>
  /* the denim desk the sheets lie on */
  .desk {
    display: flex;
    flex-direction: column;
    gap: clamp(72px, 10vw, 104px);
    min-height: 100svh;
    padding: 96px clamp(10px, 4vw, 40px) 112px;
    background: #8ea2bb var(--denim) center top / 740px auto repeat;
  }

  /* a sheet of letter paper with a printed double border, laid slightly askew */
  .sheet {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(64px, 9vw, 88px) clamp(22px, 6vw, 64px) clamp(52px, 7vw, 72px);
    background: #fff;
    box-shadow: 0 18px 40px -12px rgba(20, 30, 50, 0.45);
    outline: 4px double rgba(120, 140, 185, 0.55);
    outline-offset: clamp(-16px, -1.8vw, -9px);
    transform: rotate(var(--tilt, 0deg));
  }
  .sheet::after {
    content: '';
    position: absolute;
    inset: clamp(15px, 2.8vw, 26px);
    border: 1.5px dashed rgba(214, 160, 100, 0.55);
    pointer-events: none;
  }
  .intro {
    padding-top: clamp(40px, 6vw, 64px);
    padding-left: clamp(16px, 4vw, 48px);
    padding-right: clamp(16px, 4vw, 48px);
  }
  .sheet-intro {
    text-align: center;
    margin-bottom: 32px;
  }

  /* flag-coloured card label tucked over the top edge of a sheet, like the home buttons */
  .label {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    margin: 0;
    padding: 6px;
    background-color: var(--card-bg);
    /* faint paper grain */
    background-image: linear-gradient(170deg, rgba(255, 255, 255, 0.16), rgba(0, 0, 0, 0.05));
    color: var(--card-ink);
    font-size: clamp(1.05rem, 3.2vw, 1.55rem);
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.28);
    transform: translate(-50%, -55%) rotate(var(--r, 0deg));
  }
  .label span {
    display: block;
    padding: 0.6em 0.95em 0.5em;
    border: 4px double var(--card-rule, currentColor);
  }
  [data-flag='en'] .label--1 {
    --card-bg: var(--ke-black);
    --card-ink: var(--ke-black-ink);
  }
  [data-flag='en'] .label--2 {
    --card-bg: var(--ke-red);
    --card-ink: var(--ke-red-ink);
  }
  [data-flag='en'] .label--3 {
    --card-bg: var(--ke-green);
    --card-ink: var(--ke-green-ink);
  }
  [data-flag='fr'] .label--1 {
    --card-bg: var(--fr-blue);
    --card-ink: var(--fr-blue-ink);
  }
  [data-flag='fr'] .label--2 {
    --card-bg: var(--fr-white);
    --card-ink: var(--fr-white-ink);
    --card-rule: var(--fr-white-rule);
  }
  [data-flag='fr'] .label--3 {
    --card-bg: var(--fr-red);
    --card-ink: var(--fr-red-ink);
  }

  figure {
    margin: 0;
    position: relative;
  }
  figure img {
    width: 100%;
  }

  /* hand-written annotations with arrows, as on the old Wix site */
  .note {
    position: absolute;
    margin: 0;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: clamp(11px, 1.7vw, 15px);
    line-height: 1.05;
    color: #5a5a5a;
    text-align: center;
  }
  .note :global(.arrow) {
    width: clamp(40px, 9vw, 80px);
  }

  .church {
    max-width: 900px;
    margin: 0 auto;
  }
  .note--ceremony {
    right: 2%;
    top: 9%;
  }
  .note--ceremony :global(.arrow) {
    margin: 4px 0 0 18%;
  }
  .note--grandparents {
    left: 6%;
    top: 97%;
  }
  .note--grandparents :global(.arrow) {
    margin: 0 0 6px -4%;
  }

  .title {
    text-align: center;
    padding: clamp(72px, 12vw, 120px) var(--gutter) 0;
    animation: rise 1.2s ease both;
  }
  .title h1 {
    font-size: clamp(2.7rem, 8.5vw, 4.4rem);
    line-height: 1;
    margin-bottom: 18px;
  }
  .title p {
    font-size: clamp(1.1rem, 3vw, 1.4rem);
    margin: 0 0 10px;
  }
  .rsvp-pill {
    display: inline-block;
    margin-top: 28px;
    padding: 8px 30px 10px;
    border-radius: var(--radius-pill);
    background: #fff;
    box-shadow: 0 6px 18px rgba(44, 44, 44, 0.16);
    color: var(--color-headline);
    font-family: var(--font-headline);
    font-size: clamp(1.4rem, 4vw, 1.75rem);
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .rsvp-pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(44, 44, 44, 0.2);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .reception {
    max-width: 760px;
    margin: clamp(48px, 8vw, 72px) auto 0;
    padding: 0 var(--gutter) 0 calc(var(--gutter) + 14%);
  }
  .note--reception {
    left: var(--gutter);
    top: 9%;
  }
  .note--reception :global(.arrow) {
    margin: 4px 0 0 30%;
  }

  .venue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 48px;
    max-width: 760px;
    margin: 0 auto;
  }
  .venue {
    text-align: center;
  }
  .venue h3 {
    font-size: 1.7rem;
    margin-bottom: 6px;
  }
  .venue .muted {
    margin-bottom: 10px;
  }


  .timeline {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 480px;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 88px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: var(--color-rule);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 72px 32px 1fr;
    align-items: start;
  }
  .timeline li + li {
    margin-top: 32px;
  }
  .time {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 1.15rem;
    text-align: right;
    padding-top: 2px;
  }
  .dot {
    width: 9px;
    height: 9px;
    margin: 10px auto 0;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--color-ink);
    position: relative;
    z-index: 1;
  }
  .timeline h3 {
    font-size: 1.35rem;
    line-height: 1.4;
  }
  .timeline p {
    margin: 2px 0 0;
    font-size: 15px;
  }
  .timeline-note {
    text-align: center;
    margin: 48px 0 0;
    font-style: italic;
  }

  .sub + .sub {
    margin-top: 56px;
    padding-top: 56px;
    border-top: 1px solid var(--color-rule);
  }
  .sub-title {
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    margin-bottom: 16px;
  }
  .outro {
    margin-top: 32px;
    font-size: 15px;
  }
</style>
