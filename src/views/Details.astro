---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import Arrow from '../components/Arrow.astro';
import RuleList from '../components/RuleList.astro';
import recatadou from '../assets/illus-recatadou.png';
import church from '../assets/illus-church-street.jpg';
import denimTile from '../assets/denim-tile.jpg';
import { type Lang } from '../i18n';
import { t } from '../content';
import { MAPS } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = t(lang);
const c = all.info;
// the same denim as the home page, behind the paper sheets
const denim = await getImage({ src: denimTile, width: 1480, format: 'webp' });
---

<Base lang={lang} title={c.title}>
  <!-- Each section is a sheet of paper on the denim, with a flag-coloured card label
       tucked over its top edge, coloured like the home buttons -->
  <h1 class="sr-only">{c.title}</h1>
  <div class="desk" style={`--denim: url(${denim.src})`} data-flag={lang}>
  <section class="sheet" id="venues" style="--tilt: 0.5deg" aria-labelledby="venues-title">
    <h2 class="label label--1" id="venues-title" style="--r: -3deg"><span>{c.venuesTitle}</span></h2>

    <!-- each venue's watercolour, with its details written on as a hand-drawn label whose
         arrow points at the building (after the arrow labels on the old Wix site) -->
    <article class="venue venue--ceremony">
      <figure class="art">
        <figcaption class="pin pin--ceremony">
          <p>{c.ceremony.label} ·</p>
          <p>{c.ceremony.name}</p>
          <p>{c.ceremony.town}</p>
          <a href={MAPS.ceremony} target="_blank" rel="noopener">{c.directions}</a>
          <Arrow transform="scaleX(-1)" />
        </figcaption>
        <Image
          src={church}
          alt="Watercolour of the stone steps in L’Argentiere climbing to the church spire, past Josephine’s grandparents’ house"
          widths={[640, 1024]}
          sizes="(max-width: 820px) 90vw, 720px"
          loading="eager"
          fetchpriority="high"
        />
        <p class="note note--grandparents">
          <Arrow transform="rotate(180deg)" />
          <span>{c.notes.grandparents[0]}<br />{c.notes.grandparents[1]}</span>
        </p>
      </figure>
    </article>

    <article class="venue venue--reception">
      <figure class="art">
        <figcaption class="pin pin--reception">
          <p>{c.reception.label} ·</p>
          <p>{c.reception.name}</p>
          <p>{c.reception.town}</p>
          <a href={MAPS.reception} target="_blank" rel="noopener">{c.directions}</a>
          <Arrow transform="rotate(10deg)" />
        </figcaption>
        <Image
          src={recatadou}
          alt="Watercolour of the Salle du Recatadou: a stone house on a clifftop above the Ardèche gorge"
          widths={[640, 1048]}
          sizes="(max-width: 820px) 90vw, 640px"
        />
      </figure>
    </article>
  </section>

  <section class="sheet" id="schedule" style="--tilt: -0.4deg" aria-labelledby="schedule-title">
    <h2 class="label label--2" id="schedule-title" style="--r: 2deg"><span>{all.timings.title}</span></h2>
    <div class="column">
      <ol class="timeline">
        {
          all.timings.items.map((item) => (
            <li data-reveal>
              <span class="time">{item.time}</span>
              <span class="dot" aria-hidden="true" />
              <div>
                <h3>{item.title}</h3>
                <p class="muted">{item.place}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="timeline-note muted" data-reveal>{all.timings.transportNote}</p>
    </div>
  </section>

  <section class="sheet" id="travel" style="--tilt: 0.5deg" aria-labelledby="travel-title">
    <h2 class="label label--3" id="travel-title" style="--r: -2deg"><span>{all.travel.title}</span></h2>
    <div class="column">
      <div class="sub" data-reveal>
        <p class="eyebrow">{all.travel.gettingEyebrow}</p>
        <h3 class="sub-title">{all.travel.gettingTitle}</h3>
        <p class="muted">{all.travel.gettingIntro}</p>
        {
          all.travel.getting.map((g) => (
            <>
              <h4 class="group-label">{g.label}</h4>
              <RuleList entries={g.entries} />
            </>
          ))
        }
      </div>

      <div class="sub" data-reveal>
        <p class="eyebrow">{all.travel.stayEyebrow}</p>
        <h3 class="sub-title">{all.travel.stayTitle}</h3>
        <p class="muted">{all.travel.stayIntro}</p>
        {
          all.travel.stay.map((g) => (
            <>
              <h4 class="group-label">{g.label}</h4>
              <RuleList entries={g.entries} />
            </>
          ))
        }
        <p class="muted outro">{all.travel.stayOutro}</p>
      </div>
    </div>
  </section>

  <section class="sheet" id="qa" style="--tilt: -0.3deg" aria-labelledby="qa-title">
    <h2 class="label label--1" id="qa-title" style="--r: 3deg"><span>{all.faqs.title}</span></h2>
    <div class="column">
      <p class="sheet-intro muted">{all.faqs.intro}</p>
      <div data-reveal>
        <FaqList items={all.faqs.items} />
      </div>
    </div>
  </section>
  </div>
</Base>

<style>
  /* the denim desk the sheets lie on */
  .desk {
    display: flex;
    flex-direction: column;
    gap: clamp(72px, 10vw, 104px);
    min-height: 100svh;
    padding: 128px clamp(10px, 4vw, 40px) 112px;
    background: #8ea2bb var(--denim) center top / 740px auto repeat;
  }

  /* a sheet of letter paper with a printed double border, laid slightly askew */
  .sheet {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(64px, 9vw, 88px) clamp(22px, 6vw, 64px) clamp(52px, 7vw, 72px);
    background: #fff;
    box-shadow: 0 18px 40px -12px rgba(20, 30, 50, 0.45);
    outline: 4px double rgba(120, 140, 185, 0.55);
    outline-offset: clamp(-16px, -1.8vw, -9px);
    transform: rotate(var(--tilt, 0deg));
  }
  .sheet::after {
    content: '';
    position: absolute;
    inset: clamp(15px, 2.8vw, 26px);
    border: 1.5px dashed rgba(214, 160, 100, 0.55);
    pointer-events: none;
  }
  .sheet-intro {
    text-align: center;
    margin-bottom: 32px;
  }

  /* flag-coloured card label tucked over the top edge of a sheet, like the home buttons */
  .label {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    margin: 0;
    padding: 6px;
    background-color: var(--card-bg);
    /* faint paper grain */
    background-image: linear-gradient(170deg, rgba(255, 255, 255, 0.16), rgba(0, 0, 0, 0.05));
    color: var(--card-ink);
    font-size: clamp(1.05rem, 3.2vw, 1.55rem);
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.28);
    transform: translate(-50%, -55%) rotate(var(--r, 0deg));
  }
  .label span {
    display: block;
    padding: 0.6em 0.95em 0.5em;
    border: 4px double var(--card-rule, currentColor);
  }
  [data-flag='en'] .label--1 {
    --card-bg: var(--ke-black);
    --card-ink: var(--ke-black-ink);
  }
  [data-flag='en'] .label--2 {
    --card-bg: var(--ke-red);
    --card-ink: var(--ke-red-ink);
  }
  [data-flag='en'] .label--3 {
    --card-bg: var(--ke-green);
    --card-ink: var(--ke-green-ink);
  }
  [data-flag='fr'] .label--1 {
    --card-bg: var(--fr-blue);
    --card-ink: var(--fr-blue-ink);
  }
  [data-flag='fr'] .label--2 {
    --card-bg: var(--fr-white);
    --card-ink: var(--fr-white-ink);
    --card-rule: var(--fr-white-rule);
  }
  [data-flag='fr'] .label--3 {
    --card-bg: var(--fr-red);
    --card-ink: var(--fr-red-ink);
  }

  figure {
    margin: 0;
    position: relative;
  }
  figure img {
    width: 100%;
  }

  /* a venue: its watercolour, with its details written on as a hand-drawn label and
     arrow, like the "To Josephine's grandparents" note (after the old Wix site) */
  .art {
    position: relative;
    container-type: inline-size;
    max-width: 720px;
    margin: 0 auto;
  }
  .venue--reception {
    margin-top: clamp(72px, 10vw, 104px);
  }

  .pin,
  .note {
    position: absolute;
    margin: 0;
    font-family: var(--font-headline);
    font-size: clamp(13px, 2vw, 16px);
    line-height: 1.15;
    color: var(--color-headline);
    text-align: center;
  }
  .pin p {
    margin: 0;
  }
  .pin a {
    display: inline-block;
    margin-top: 3px;
    color: #1a5fb4;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pin :global(.arrow),
  .note :global(.arrow) {
    width: clamp(40px, 7vw, 64px);
    color: #5a5a5a;
  }

  /* ceremony: label at the top right of the picture, its arrow curling left to the spire.
     The label and arrow move as one, anchored from the bottom so the arrow's tip sits
     about a fifth of the way down the picture (100cqw = the picture's width; the
     picture is 0.559 as tall as it is wide). */
  .venue--ceremony .art {
    padding-top: 56px;
  }
  .pin--ceremony {
    right: -2%;
    bottom: calc(100cqw * 0.559 * 0.78);
  }
  @media (max-width: 600px) {
    .venue--ceremony .art {
      padding-top: 96px;
    }
  }
  .pin--ceremony :global(.arrow) {
    margin: 4px 0 0 18%;
  }

  /* reception: label to the left of the clifftop, its arrow pointing in at the house.
     The picture takes the right 75% of the row (100cqw = the row's width; the picture
     is 0.801 as tall as it is wide). The label and arrow move as one, placed so the
     arrow's tip lands on the house, about 9% across and 37% down the picture. */
  .venue--reception .art {
    max-width: 680px;
  }
  .venue--reception img {
    width: 75%;
    margin-left: 25%;
  }
  .pin--reception {
    left: calc(25cqw + 75cqw * 0.09 - 113px);
    bottom: calc(75cqw * 0.801 * 0.63);
  }
  .pin--reception :global(.arrow) {
    margin: 4px 0 0 40%;
  }
  @media (max-width: 600px) {
    /* no room beside the picture on phones: label at its top left, arrow down to the house */
    .venue--reception .art {
      padding-top: 48px;
    }
    .venue--reception img {
      width: 100%;
      margin-left: 0;
    }
    /* the arrow's tip sits about 22% down the full-width picture, on the house */
    .pin--reception {
      left: 0;
      bottom: calc(100cqw * 0.801 * 0.78 + 12px);
    }
    .pin--reception :global(.arrow) {
      margin: 2px 0 0 60%;
      transform: rotate(50deg) !important;
    }
  }

  /* "To Josephine's grandparents" under the picture, arrow up to the houses */
  .note--grandparents {
    left: 4%;
    top: calc(100% - 14px);
  }
  .note--grandparents :global(.arrow) {
    margin: 0 0 4px -4%;
  }
  .venue--ceremony {
    /* clear the grandparents label hanging below the picture */
    padding-bottom: 56px;
  }

  .timeline {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 480px;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 88px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: var(--color-rule);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 72px 32px 1fr;
    align-items: start;
  }
  .timeline li + li {
    margin-top: 32px;
  }
  .time {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 1.15rem;
    text-align: right;
    padding-top: 2px;
  }
  .dot {
    width: 9px;
    height: 9px;
    margin: 10px auto 0;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--color-ink);
    position: relative;
    z-index: 1;
  }
  .timeline h3 {
    font-size: 1.35rem;
    line-height: 1.4;
  }
  .timeline p {
    margin: 2px 0 0;
    font-size: 15px;
  }
  .timeline-note {
    text-align: center;
    margin: 48px 0 0;
    font-style: italic;
  }

  .sub + .sub {
    margin-top: 56px;
    padding-top: 56px;
    border-top: 1px solid var(--color-rule);
  }
  .sub-title {
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    margin-bottom: 16px;
  }
  .outro {
    margin-top: 32px;
    font-size: 15px;
  }
</style>
