---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import recatadou from '../assets/illus-recatadou.png';
import church from '../assets/illus-church-street.jpg';
import { href, type Lang } from '../i18n';
import { t } from '../content';
import { MAPS } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = t(lang);
const c = all.info;
---

<Base lang={lang} title={c.title}>
  <section class="hero">
    <Image
      class="hero-illus"
      src={recatadou}
      alt="Watercolour of the Salle du Recatadou: a stone house on a clifftop above the Ardèche gorge"
      widths={[480, 760, 1152]}
      sizes="(max-width: 640px) 88vw, 560px"
      loading="eager"
      fetchpriority="high"
    />
    <h1 class="hero-names">{all.names}</h1>
    <p class="hero-meta">
      <span>{c.date}</span>
      <span>{c.place}</span>
    </p>
  </section>

  <section class="story" aria-labelledby="story-title">
    <div class="column story-text" data-reveal>
      <p class="eyebrow">{c.storyEyebrow}</p>
      <h2 class="section-title" id="story-title">{c.storyTitle}</h2>
      {c.story.map((p) => <p class="muted">{p}</p>)}
    </div>
  </section>

  <section class="page venues" aria-labelledby="venues-title">
    <div class="column">
      <header class="venues-head" data-reveal>
        <p class="eyebrow">{c.venuesEyebrow}</p>
        <h2 class="section-title" id="venues-title">{c.venuesTitle}</h2>
      </header>
    </div>
    <div class="venue-grid">
      <article class="venue" data-reveal>
        <Image src={church} alt="Watercolour of stone steps climbing to a church spire" widths={[440, 880]} sizes="(max-width: 760px) 90vw, 440px" />
        <p class="eyebrow">{c.ceremony.label}</p>
        <h3>{c.ceremony.name}</h3>
        <p class="muted">{c.ceremony.town}</p>
        <a class="text-link" href={MAPS.ceremony} target="_blank" rel="noopener">{c.directions} ↗</a>
      </article>
      <article class="venue" data-reveal>
        <Image src={recatadou} alt="Watercolour of the Salle du Recatadou above the gorge" widths={[440, 880]} sizes="(max-width: 760px) 90vw, 440px" />
        <p class="eyebrow">{c.reception.label}</p>
        <h3>{c.reception.name}</h3>
        <p class="muted">{c.reception.town}</p>
        <a class="text-link" href={MAPS.reception} target="_blank" rel="noopener">{c.directions} ↗</a>
      </article>
    </div>
  </section>

  <section class="cta" data-reveal>
    <h2 class="section-title">{c.ctaTitle}</h2>
    <p class="muted">{c.ctaText}</p>
    <a class="btn" href={href(lang, 'rsvp')}>{c.ctaButton}</a>
  </section>
</Base>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 96px var(--gutter) 64px;
  }
  .hero-illus {
    width: min(560px, 88vw);
    max-height: 48svh;
    object-fit: contain;
    margin-bottom: clamp(20px, 4vh, 40px);
    animation: rise 1.4s ease both;
  }
  .hero-names {
    font-size: clamp(2.6rem, 9vw, 5.2rem);
    letter-spacing: -0.01em;
    animation: rise 1.4s 0.2s ease both;
  }
  .hero-meta {
    margin: 22px 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    animation: rise 1.4s 0.4s ease both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .story {
    padding: 64px 0 0;
    border-top: 1px solid var(--color-rule);
  }
  .story-text {
    padding: 0 var(--gutter);
    text-align: center;
  }

  .venues {
    padding-top: 96px;
  }
  .venues-head {
    text-align: center;
    margin-bottom: 48px;
  }
  .venue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 56px 48px;
    max-width: 960px;
    margin: 0 auto;
  }
  .venue {
    text-align: center;
  }
  .venue img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    margin-bottom: 20px;
  }
  .venue h3 {
    font-size: 1.7rem;
    margin-bottom: 6px;
  }
  .venue .muted {
    margin-bottom: 10px;
  }

  .cta {
    text-align: center;
    padding: 24px var(--gutter) 112px;
  }
  .cta .btn {
    margin-top: 12px;
  }
</style>
