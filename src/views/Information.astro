---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import recatadou from '../assets/illus-recatadou.png';
import church from '../assets/illus-church-street.jpg';
import { type Lang } from '../i18n';
import { t } from '../content';
import { MAPS } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = t(lang);
const c = all.info;
---

<Base lang={lang} title={c.title}>
  <section class="hero">
    <Image
      class="hero-illus"
      src={recatadou}
      alt="Watercolour of the Salle du Recatadou: a stone house on a clifftop above the Ardèche gorge"
      widths={[480, 760, 1152]}
      sizes="(max-width: 640px) 88vw, 560px"
      loading="eager"
      fetchpriority="high"
    />
    <h1 class="hero-names">{all.names}</h1>
    <p class="hero-meta">
      <span>{c.date}</span>
      <span>{c.place}</span>
    </p>
  </section>

  <section class="page venues" aria-labelledby="venues-title">
    <div class="column">
      <header class="venues-head" data-reveal>
        <p class="eyebrow">{c.venuesEyebrow}</p>
        <h2 class="section-title" id="venues-title">{c.venuesTitle}</h2>
      </header>
      <Image
        class="venues-illus"
        src={church}
        alt="Watercolour of stone steps climbing to a church spire"
        widths={[640, 1024]}
        sizes="(max-width: 640px) 90vw, 640px"
        data-reveal
      />
    </div>
    <div class="venue-grid">
      <article class="venue" data-reveal>
        <p class="eyebrow">{c.ceremony.label}</p>
        <h3>{c.ceremony.name}</h3>
        <p class="muted">{c.ceremony.town}</p>
        <a class="text-link" href={MAPS.ceremony} target="_blank" rel="noopener">{c.directions} ↗</a>
      </article>
      <article class="venue" data-reveal>
        <p class="eyebrow">{c.reception.label}</p>
        <h3>{c.reception.name}</h3>
        <p class="muted">{c.reception.town}</p>
        <a class="text-link" href={MAPS.reception} target="_blank" rel="noopener">{c.directions} ↗</a>
      </article>
    </div>
  </section>

  <section class="page faq-section" aria-labelledby="faqs-title">
    <div class="column">
      <header class="venues-head" data-reveal>
        <h2 class="section-title" id="faqs-title">{all.faqs.title}</h2>
        <p class="muted">{all.faqs.intro}</p>
      </header>
      <div data-reveal>
        <FaqList items={all.faqs.items} />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 96px var(--gutter) 64px;
  }
  .hero-illus {
    width: min(560px, 88vw);
    max-height: 48svh;
    object-fit: contain;
    margin-bottom: clamp(20px, 4vh, 40px);
    animation: rise 1.4s ease both;
  }
  .hero-names {
    font-size: clamp(2.6rem, 9vw, 5.2rem);
    letter-spacing: -0.01em;
    animation: rise 1.4s 0.2s ease both;
  }
  .hero-meta {
    margin: 22px 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    animation: rise 1.4s 0.4s ease both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .venues {
    border-top: 1px solid var(--color-rule);
    padding-top: 96px;
    padding-bottom: 0;
  }
  .venues-head {
    text-align: center;
    margin-bottom: 40px;
  }
  .venues-illus {
    width: 100%;
    margin: 0 auto 48px;
  }
  .venue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 48px;
    max-width: 760px;
    margin: 0 auto;
  }
  .venue {
    text-align: center;
  }
  .venue h3 {
    font-size: 1.7rem;
    margin-bottom: 6px;
  }
  .venue .muted {
    margin-bottom: 10px;
  }

  .faq-section {
    padding-top: 112px;
  }
</style>
