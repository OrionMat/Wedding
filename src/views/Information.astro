---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import Arrow from '../components/Arrow.astro';
import recatadou from '../assets/illus-recatadou.png';
import church from '../assets/illus-church-street.jpg';
import { href, type Lang } from '../i18n';
import { t } from '../content';
import { MAPS } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = t(lang);
const c = all.info;
---

<Base lang={lang} title={c.title}>
  <section class="intro">
    <figure class="church">
      <Image
        src={church}
        alt="Watercolour of the stone steps in L’Argentiere climbing to the church spire, past Josephine’s grandparents’ house"
        widths={[640, 1024]}
        sizes="(max-width: 900px) 100vw, 900px"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="note note--ceremony">
        <span>{c.notes.ceremony[0]}<br />{c.notes.ceremony[1]}</span>
        <Arrow transform="scaleX(-1)" />
      </figcaption>
      <p class="note note--grandparents">
        <Arrow transform="rotate(180deg)" />
        <span>{c.notes.grandparents[0]}<br />{c.notes.grandparents[1]}</span>
      </p>
    </figure>

    <div class="title">
      <h1>{all.names}</h1>
      <p>{c.church}</p>
      <p>{c.date}</p>
      <a class="rsvp-pill" href={href(lang, 'rsvp')}>{c.rsvp}</a>
    </div>

    <figure class="reception" data-reveal>
      <Image
        src={recatadou}
        alt="Watercolour of the Salle du Recatadou: a stone house on a clifftop above the Ardèche gorge"
        widths={[560, 1048]}
        sizes="(max-width: 760px) 84vw, 640px"
      />
      <figcaption class="note note--reception">
        <span>{c.notes.reception[0]}<br />{c.notes.reception[1]}</span>
        <Arrow transform="rotate(10deg)" />
      </figcaption>
    </figure>
  </section>

  <section class="page venues" aria-labelledby="venues-title">
    <div class="column">
      <header class="venues-head" data-reveal>
        <p class="eyebrow">{c.venuesEyebrow}</p>
        <h2 class="section-title" id="venues-title">{c.venuesTitle}</h2>
      </header>
    </div>
    <div class="venue-grid">
      <article class="venue" data-reveal>
        <p class="eyebrow">{c.ceremony.label}</p>
        <h3>{c.ceremony.name}</h3>
        <p class="muted">{c.ceremony.town}</p>
        <a class="text-link" href={MAPS.ceremony} target="_blank" rel="noopener">{c.directions} ↗</a>
      </article>
      <article class="venue" data-reveal>
        <p class="eyebrow">{c.reception.label}</p>
        <h3>{c.reception.name}</h3>
        <p class="muted">{c.reception.town}</p>
        <a class="text-link" href={MAPS.reception} target="_blank" rel="noopener">{c.directions} ↗</a>
      </article>
    </div>
  </section>

  <section class="page faq-section" aria-labelledby="faqs-title">
    <div class="column">
      <header class="venues-head" data-reveal>
        <h2 class="section-title" id="faqs-title">{all.faqs.title}</h2>
        <p class="muted">{all.faqs.intro}</p>
      </header>
      <div data-reveal>
        <FaqList items={all.faqs.items} />
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding: 64px 0 24px;
  }
  figure {
    margin: 0;
    position: relative;
  }
  figure img {
    width: 100%;
  }

  /* hand-written annotations with arrows, as on the old Wix site */
  .note {
    position: absolute;
    margin: 0;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: clamp(11px, 1.7vw, 15px);
    line-height: 1.05;
    color: #5a5a5a;
    text-align: center;
  }
  .note :global(.arrow) {
    width: clamp(40px, 9vw, 80px);
  }

  .church {
    max-width: 900px;
    margin: 0 auto;
  }
  .note--ceremony {
    right: 2%;
    top: 9%;
  }
  .note--ceremony :global(.arrow) {
    margin: 4px 0 0 18%;
  }
  .note--grandparents {
    left: 6%;
    top: 97%;
  }
  .note--grandparents :global(.arrow) {
    margin: 0 0 6px -4%;
  }

  .title {
    text-align: center;
    padding: clamp(72px, 12vw, 120px) var(--gutter) 0;
    animation: rise 1.2s ease both;
  }
  .title h1 {
    font-size: clamp(2.7rem, 8.5vw, 4.4rem);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 18px;
  }
  .title p {
    font-size: clamp(1.1rem, 3vw, 1.4rem);
    margin: 0 0 10px;
  }
  .rsvp-pill {
    display: inline-block;
    margin-top: 28px;
    padding: 8px 30px 10px;
    border-radius: var(--radius-pill);
    background: #fff;
    box-shadow: 0 6px 18px rgba(44, 44, 44, 0.16);
    color: #2171b5;
    font-size: clamp(1.4rem, 4vw, 1.75rem);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .rsvp-pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(44, 44, 44, 0.2);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .reception {
    max-width: 760px;
    margin: clamp(48px, 8vw, 72px) auto 0;
    padding: 0 var(--gutter) 0 calc(var(--gutter) + 14%);
  }
  .note--reception {
    left: var(--gutter);
    top: 9%;
  }
  .note--reception :global(.arrow) {
    margin: 4px 0 0 30%;
  }

  .venues {
    border-top: 1px solid var(--color-rule);
    padding-top: 96px;
    padding-bottom: 0;
  }
  .venues-head {
    text-align: center;
    margin-bottom: 40px;
  }
  .venue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 48px;
    max-width: 760px;
    margin: 0 auto;
  }
  .venue {
    text-align: center;
  }
  .venue h3 {
    font-size: 1.7rem;
    margin-bottom: 6px;
  }
  .venue .muted {
    margin-bottom: 10px;
  }

  .faq-section {
    padding-top: 112px;
  }
</style>
