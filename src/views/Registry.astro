---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';
import { t } from '../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).registry;
---

<Base lang={lang} title={c.title}>
  <section class="soon">
    <h1>{c.title}</h1>
    <p class="muted">{c.text}</p>
  </section>
</Base>

<style>
  .soon {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 96px var(--gutter);
    animation: rise 1.2s ease both;
  }
  h1 {
    font-size: clamp(2.7rem, 8.5vw, 4.4rem);
  }
  .muted {
    max-width: 30em;
    margin-top: 20px;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
