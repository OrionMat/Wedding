---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { type Lang } from '../i18n';
import { t } from '../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).timings;
---

<Base lang={lang} title={c.title}>
  <div class="page">
    <div class="column">
      <PageHead title={c.title} vignette="bell" />

      <ol class="timeline">
        {
          c.items.map((item) => (
            <li data-reveal>
              <span class="time">{item.time}</span>
              <span class="dot" aria-hidden="true" />
              <div>
                <h2>{item.title}</h2>
                <p class="muted">{item.place}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="note muted" data-reveal>{c.transportNote}</p>
    </div>
  </div>
</Base>

<style>
  .timeline {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 480px;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 88px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: var(--color-rule);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 72px 32px 1fr;
    align-items: start;
  }
  .timeline li + li {
    margin-top: 32px;
  }
  .time {
    font-family: var(--font-accent);
    font-weight: 300;
    font-size: 1.15rem;
    text-align: right;
    padding-top: 2px;
  }
  .dot {
    width: 9px;
    height: 9px;
    margin: 10px auto 0;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1px solid var(--color-ink);
    position: relative;
    z-index: 1;
  }
  h2 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.4;
  }
  .timeline p {
    margin: 2px 0 0;
    font-size: 15px;
  }
  .note {
    text-align: center;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--color-rule);
    font-style: italic;
  }
</style>
