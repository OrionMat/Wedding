---
// The day as a side-scrolling strip of stages, after the schedule on finn-brinn.co.uk:
// one stage at a time, ‹ › arrows, a string of bunting whose pennants
// jump between stages, swipe on phones and the arrow keys on a keyboard.
import { Image } from 'astro:assets';
import StageArt from './StageArt.astro';
import flag1 from '../assets/bunting/flag-1.png';
import flag2 from '../assets/bunting/flag-2.png';
import flag3 from '../assets/bunting/flag-3.png';
import flag4 from '../assets/bunting/flag-4.png';
import flag5 from '../assets/bunting/flag-5.png';
import flag6 from '../assets/bunting/flag-6.png';
import { type Lang } from '../i18n';
import { t } from '../content';
import { MAPS } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = t(lang);
const c = all.timings;
const total = c.items.length;
// watercolour pennants, one per stage, hung along a string tied between the two arrows.
// The string runs from the middle of one arrow to the middle of the other (TIE px in
// under each), dipping SAG px at its middle; each pennant (W px wide, GAP apart, ENDS
// clear of the arrows) hangs from the string where it crosses it
const flags = [flag1, flag2, flag3, flag4, flag5, flag6];
const SAG = 20;
const W = 24;
const GAP = 16;
const ENDS = 16;
const TIE = 20;
const span = 2 * (TIE + ENDS) + total * W + (total - 1) * GAP;
const drop = (i: number) => {
  const t = (TIE + ENDS + W / 2 + i * (W + GAP)) / span;
  return (4 * SAG * t * (1 - t)).toFixed(1);
};
---

<div class="schedule" data-schedule>
  <ol class="track" tabindex="0" aria-label={c.title}>
    {
      c.items.map((stage, i) => (
        <li class:list={['stage', { 'is-active': i === 0 }]} aria-roledescription="slide" aria-label={`${i + 1} ${c.of} ${total}`}>
          <p class="time">{stage.time}</p>
          {stage.provisional && <p class="provisional">{stage.note} {c.provisional}</p>}
          {stage.until && (
            <p class="until">
              {c.until} {stage.until}
            </p>
          )}
          {stage.place && <p class="place">{stage.place}</p>}
          <h3>{stage.title}</h3>
          {stage.note && !stage.provisional && <p class="note-line">{stage.note}</p>}
          {stage.map && (
            <a class="directions" href={MAPS[stage.map]} target="_blank" rel="noopener">
              {c.map}
            </a>
          )}
          <StageArt art={stage.art} />
        </li>
      ))
    }
  </ol>

  <div class="controls">
    <button class="arrow" type="button" data-prev aria-label={c.prev} disabled>‹</button>
    <div class="dots" style={`--w:${W}px;--gap:${GAP}px;--ends:${ENDS}px;--tie:${TIE}px`}>
      <svg class="string" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
        <path d={`M0 2 Q 50 ${2 + SAG * 2} 100 2`} />
      </svg>
      {
        c.items.map((stage, i) => (
          <button class="dot" type="button" data-dot={i} style={`--drop:${drop(i)}px`} aria-label={`${stage.time} · ${stage.title}`} aria-current={i === 0 ? 'true' : undefined}>
            <Image src={flags[i % flags.length]} alt="" width={72} class="pennant" />
          </button>
        ))
      }
    </div>
    <button class="arrow" type="button" data-next aria-label={c.next}>›</button>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-schedule]')) {
    const track = root.querySelector<HTMLElement>('.track')!;
    const stages = Array.from(track.querySelectorAll<HTMLElement>('.stage'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // the stage we're on, or heading to while the strip slides
    let target = 0;

    // scroll position that puts a stage in the middle of the strip. Measured from the
    // stage's centre, which stays put when stages out of view are shrunk (their edges don't),
    // so the glide lands exactly where snapping would and nothing tugs it back afterwards
    const centreOf = (s: HTMLElement) => {
      const r = s.getBoundingClientRect();
      const mid = r.left + r.width / 2 - track.getBoundingClientRect().left + track.scrollLeft;
      return Math.max(0, Math.min(track.scrollWidth - track.clientWidth, mid - track.clientWidth / 2));
    };

    const show = (i: number) => {
      stages.forEach((s, n) => s.classList.toggle('is-active', n === i));
      dots.forEach((d, n) => (n === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      prev.disabled = i === 0;
      next.disabled = i === stages.length - 1;
    };

    // glide the strip to a position; snapping is paused meanwhile so it can't tug the strip elsewhere
    let glide = 0;
    let gliding = false;
    const scrollToX = (x: number, instant: boolean) => {
      cancelAnimationFrame(glide);
      const from = track.scrollLeft;
      const dist = x - from;
      if (instant || reduced || Math.abs(dist) < 1) {
        track.scrollLeft = x;
        return;
      }
      gliding = true;
      track.style.scrollSnapType = 'none';
      const start = performance.now();
      const duration = Math.min(700, 320 + Math.abs(dist) * 0.25);
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        const ease = 1 - Math.pow(1 - p, 3);
        track.scrollLeft = from + dist * ease;
        if (p < 1) glide = requestAnimationFrame(step);
        else {
          track.style.scrollSnapType = '';
          gliding = false;
        }
      };
      glide = requestAnimationFrame(step);
    };

    const go = (i: number, instant = false) => {
      target = Math.max(0, Math.min(stages.length - 1, i));
      show(target);
      scrollToX(centreOf(stages[target]), instant);
    };

    // when someone swipes or scrolls the strip themselves, follow whichever stage is nearest the middle
    const nearest = () => {
      let best = 0;
      let bestDist = Infinity;
      stages.forEach((s, i) => {
        const d = Math.abs(centreOf(s) - track.scrollLeft);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      return best;
    };
    let settle = 0;
    track.addEventListener('scroll', () => {
      if (gliding) return;
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        target = nearest();
        show(target);
      }, 120);
    });

    prev.addEventListener('click', () => go(target - 1));
    next.addEventListener('click', () => go(target + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(target + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(target - 1);
      }
    });
    window.addEventListener('resize', () => go(target, true));
    go(0, true);
  }
</script>

<style>
  .track {
    /* one stage at a time, filling the strip; the gap keeps the next one out of sight */
    display: flex;
    gap: 6%;
    padding: 8px 0 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    outline-offset: -6px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .stage {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    opacity: 0.28;
    transform: scale(0.94);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .stage.is-active {
    opacity: 1;
    transform: none;
  }
  /* only the stage you're looking at is animated */
  .stage:not(.is-active) :global(*) {
    animation-play-state: paused !important;
  }

  .stage p {
    margin: 0;
  }
  .time {
    font-family: var(--font-headline);
    font-size: clamp(2.6rem, 8vw, 3.6rem);
    line-height: 1;
    color: var(--color-headline);
  }
  .until {
    margin-top: 4px !important;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .provisional {
    max-width: 30em;
    margin: 10px 0 6px !important;
    text-wrap: balance;
    color: var(--color-ink-soft);
  }
  .stage h3 {
    margin: 12px 0 6px;
    font-size: clamp(1.5rem, 4.4vw, 2rem);
    line-height: 1.1;
  }
  .place {
    margin-top: 14px !important;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-headline);
  }
  .note-line {
    max-width: 30em;
    margin-top: 8px !important;
    color: var(--color-ink-soft);
  }
  .directions {
    margin-top: 6px;
    font-family: var(--font-headline);
    color: #1a5fb4;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* every stage's picture sits at the foot of the stage, on one shared line just
     above the arrows, however much text the stage has */
  .stage :global(.stage-art) {
    margin-top: auto;
    width: 100%;
  }
  .stage > :nth-last-child(2) {
    margin-bottom: 22px !important;
  }

  /* ‹ ••••• › under the strip */
  .controls {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: 26px;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0 0 4px;
    border: 0;
    border-radius: 50%;
    /* solid, so the string's tied-off ends tuck in behind */
    position: relative;
    z-index: 1;
    background: #f4f1ec;
    color: var(--color-headline);
    font: 400 28px/1 var(--font-headline);
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .arrow:hover:not(:disabled) {
    background: #e9e3da;
  }
  .arrow:disabled {
    color: rgba(75, 54, 24, 0.25);
    cursor: default;
  }
  /* bunting: watercolour pennants on a sagging string, one per stage. The one you're
     on hangs a little lower and sways in the breeze; the rest are faded */
  .dots {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
    /* the string's ends reach in under the arrows, to their middles */
    margin: 18px calc(var(--tie) * -1) 0;
    padding: 0 calc(var(--tie) + var(--ends));
    height: 56px;
  }
  .string {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 20px;
    overflow: visible;
    pointer-events: none;
  }
  .string path {
    fill: none;
    stroke: #c7a26a;
    stroke-width: 1.6;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .dot {
    position: relative;
    display: block;
    width: var(--w);
    flex: none;
    margin-top: var(--drop);
    padding: 0;
    border: 0;
    background: none;
    opacity: 0.62;
    cursor: pointer;
    transform-origin: 50% 2px;
    transition: opacity 0.25s ease, transform 0.3s ease;
  }
  .dot :global(.pennant) {
    display: block;
    width: 100%;
    height: auto;
  }
  .dot:hover {
    opacity: 0.85;
    transform: rotate(-6deg);
  }
  .dot[aria-current] {
    opacity: 1;
    transform: translateY(3px) scale(1.18);
    animation: flutter 1.8s ease-in-out infinite alternate;
  }
  .dot:focus-visible {
    outline: 2px solid var(--color-headline);
    outline-offset: 3px;
  }
  @keyframes flutter {
    from {
      transform: translateY(3px) scale(1.18) rotate(-5deg);
    }
    to {
      transform: translateY(3px) scale(1.18) rotate(5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage :global(*),
    .dot {
      animation: none !important;
    }
  }
</style>
