---
import Vignette from './Vignette.astro';

interface Props {
  title: string;
  intro?: string;
  vignette: 'flower' | 'bell' | 'train' | 'canoe' | 'letter';
  /** h1 for a page title, h2 for a section within a page */
  level?: 'h1' | 'h2';
  id?: string;
}
const { title, intro, vignette, level = 'h1', id } = Astro.props;
const Heading = level;
---

<header class="page-head" data-reveal>
  <Vignette name={vignette} />
  <Heading class="page-title" id={id}>{title}</Heading>
  {intro && <p class="page-intro">{intro}</p>}
</header>
