---
// Placeholder watercolour-style vignettes for page headers.
// TODO: replace with commissioned watercolours matching the Home illustrations (see CONTENT_TODO.md).
interface Props {
  name: 'flower' | 'bell' | 'train' | 'canoe' | 'letter';
}
const { name } = Astro.props;
const id = `wash-${name}`;
---

<svg class="vignette" viewBox="0 0 120 120" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <defs>
    <filter id={id} x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="3" seed="7"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="10"></feDisplacementMap>
      <feGaussianBlur stdDeviation="1.4"></feGaussianBlur>
    </filter>
  </defs>

  {
    name === 'flower' && (
      <g>
        <g filter={`url(#${id})`} opacity="0.55">
          <circle cx="60" cy="38" r="20" fill="#e8c88f" />
          <ellipse cx="44" cy="82" rx="12" ry="6" fill="#a9b98c" transform="rotate(-30 44 82)" />
          <ellipse cx="74" cy="72" rx="12" ry="6" fill="#a9b98c" transform="rotate(25 74 72)" />
        </g>
        <g stroke="#5a5a52" stroke-width="1.2">
          <path d="M60 58c-1 18 1 34 0 52" />
          <path d="M60 86c-6-6-14-8-22-6M60 76c6-6 14-7 22-4" />
          {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
            <ellipse cx="60" cy="24" rx="5" ry="12" transform={`rotate(${a} 60 38)`} />
          ))}
          <circle cx="60" cy="38" r="5" />
        </g>
      </g>
    )
  }

  {
    name === 'bell' && (
      <g>
        <g filter={`url(#${id})`} opacity="0.5">
          <rect x="40" y="22" width="40" height="80" rx="4" fill="#e6d5b8" />
          <circle cx="60" cy="50" r="14" fill="#9fb3cc" />
        </g>
        <g stroke="#5a5a52" stroke-width="1.2">
          <path d="M60 6l-20 18h40z" />
          <path d="M42 24v84M78 24v84M36 108h48" />
          <circle cx="60" cy="50" r="12" />
          <path d="M60 50v-8M60 50l6 4" />
          <path d="M52 108V82a8 8 0 0116 0v26" />
        </g>
      </g>
    )
  }

  {
    name === 'train' && (
      <g>
        <g filter={`url(#${id})`} opacity="0.5">
          <rect x="18" y="46" width="84" height="40" rx="10" fill="#9fb3cc" />
          <circle cx="92" cy="30" r="10" fill="#e8c88f" />
        </g>
        <g stroke="#5a5a52" stroke-width="1.2">
          <path d="M20 86V58c0-8 6-12 14-12h44c14 0 24 10 24 24v16z" />
          <path d="M30 56h14v12H30zM52 56h14v12H52zM74 56h10l8 12H74z" />
          <circle cx="36" cy="92" r="6" />
          <circle cx="84" cy="92" r="6" />
          <path d="M8 100h104" />
          <path d="M14 106h4M30 106h4M46 106h4M62 106h4M78 106h4M94 106h4" />
        </g>
      </g>
    )
  }

  {
    name === 'canoe' && (
      <g>
        <g filter={`url(#${id})`} opacity="0.5">
          <ellipse cx="60" cy="88" rx="50" ry="12" fill="#9fb3cc" />
          <path d="M14 64c8-40 28-50 46-50s38 10 46 50z" fill="#c9b48a" />
        </g>
        <g stroke="#5a5a52" stroke-width="1.2">
          <path d="M14 64c10-28 26-40 40-44M106 64c-8-24-22-36-36-42" />
          <path d="M18 80c14 8 70 8 84 0-4 8-14 12-42 12S22 88 18 80z" />
          <path d="M36 98c8 2 16 2 24 0s16-2 24 0" />
          <path d="M46 70l26 22" />
          <path d="M70 89l8 6" stroke-width="3" />
        </g>
      </g>
    )
  }

  {
    name === 'letter' && (
      <g>
        <g filter={`url(#${id})`} opacity="0.55">
          <rect x="18" y="34" width="84" height="58" rx="3" fill="#c9a77a" />
          <circle cx="60" cy="70" r="10" fill="#9fb3cc" />
        </g>
        <g stroke="#5a5a52" stroke-width="1.2">
          <rect x="20" y="36" width="80" height="54" rx="2" />
          <path d="M20 38l40 30 40-30" />
          <circle cx="60" cy="70" r="4" />
          <path d="M60 74c4 8 10 12 18 14" />
        </g>
      </g>
    )
  }
</svg>
