---
// Hand-drawn curved arrow from the old Wix site. In its natural orientation the tail
// starts top-left and the curve sweeps down to an arrowhead pointing right.
// Flip or rotate it with `transform` to point where you need.
interface Props {
  class?: string;
  transform?: string;
}
const { class: className, transform } = Astro.props;
---

