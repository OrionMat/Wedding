---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faqs">
  {
    items.map((item) => (
      <details>
        <summary>
          <span>{item.q}</span>
          <span class="icon" aria-hidden="true" />
        </summary>
        <p class="muted">{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faqs {
    text-align: left;
  }
  details {
    border-top: 1px solid var(--color-rule);
  }
  details:last-child {
    border-bottom: 1px solid var(--color-rule);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .icon {
    flex: none;
    position: relative;
    width: 14px;
    height: 14px;
  }
  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6.5px;
    width: 14px;
    height: 1px;
    background: currentColor;
    transition: transform 0.25s ease;
  }
  .icon::after {
    transform: rotate(90deg);
  }
  details[open] .icon::after {
    transform: rotate(0);
  }
  details p {
    margin: -6px 0 22px;
    padding-right: 30px;
  }
</style>
