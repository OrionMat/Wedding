---
// The illustration for one schedule stage, with a small looping animation.
// Every stage but the last ('stars') uses a watercolour; that one is still a hand-drawn
// placeholder in the same washed style until a matching watercolour is made
// (see CONTENT_TODO.md). Animations pause on stages that aren't showing and are
// switched off for people who prefer reduced motion.
import { Image } from 'astro:assets';
import church from '../assets/illus-church.png';
import dawa from '../assets/illus-dawa.png';
import cars from '../assets/illus-cars.png';
import dinner from '../assets/illus-dinner.png';
import decks from '../assets/illus-decks.png';
import fader1 from '../assets/fader-1.png';
import fader2 from '../assets/fader-2.png';
import fader3 from '../assets/fader-3.png';
import fader4 from '../assets/fader-4.png';
import fader5 from '../assets/fader-5.png';
// the convoy stands still while its wheels whirl: a few spokes drawn over each
// hubcap spin round at an easy pace. Centre x, centre y and hubcap radius, in the picture's pixels (1838 × 544).
const wheels = [
  [160, 473, 36], [571, 471, 36],
  [809, 476, 29], [1059, 477, 29],
  [1301, 477, 33], [1692, 476, 33],
];
import type { StageArt } from '../content';

interface Props {
  art: StageArt;
}
const { art } = Astro.props;
const ink = '#5a5a52';
// the tips of the three tall candles on the dinner table, in the picture's pixels (1785 × 512)
const candles = [[562, 30], [1008, 6], [1424, 28]];
// fizz in a dawa and a spritz raised together: bubbles rising through each drink to its
// surface. Across, start height and the surface they rise to (in the picture's pixels,
// 1218 × 1199), radius, delay (s), rise time (s)
const bubbles = [
  // the dawa, on the left
  [100, 720, 405, 14, 0, 3.4], [180, 730, 410, 10, 1.3, 3], [260, 735, 415, 16, 2.2, 3.6],
  [330, 730, 422, 12, 0.6, 3.1], [420, 725, 430, 14, 1.9, 3.4], [480, 690, 435, 9, 2.7, 2.7],
  [150, 650, 408, 9, 3.1, 2.6],
  // the spritz, on the right: finer and livelier
  [700, 620, 245, 9, 0.2, 2.8], [760, 630, 240, 8, 1.1, 2.6], [820, 630, 235, 10, 1.8, 3],
  [880, 620, 230, 8, 0.7, 2.5], [650, 560, 250, 8, 2.4, 2.6], [960, 580, 225, 8, 1.5, 2.5],
  [1040, 500, 218, 7, 2.9, 2.2], [790, 590, 238, 7, 3.3, 2.4], [610, 480, 252, 7, 0.4, 2.1],
];
// glints of light catching the salt on the dawa's rim and the spritz glass's lip
const glints = [[90, 275, 0], [545, 350, 1.4], [560, 110, 0.6], [940, 20, 2.1]];
// the mixer's five faders, their caps cut out of the picture (which has the slots painted
// empty). The first and middle ones now and then slide up and down by themselves, each in
// its own time; the other three can be dragged up and down their tracks. In the picture's
// pixels: the cap's resting box, the track's top and bottom, and for the self-moving ones
// their timing (s)
const faders = [
  { cap: fader1, x: 663, y: 169, w: 41, h: 31, top: [690, 150], bot: [675, 243], t: 8, d: -1 },
  { cap: fader2, x: 734, y: 192, w: 40, h: 31, top: [757, 150], bot: [752, 245] },
  { cap: fader3, x: 806, y: 153, w: 38, h: 30, top: [822, 147], bot: [824, 240], t: 11, d: -6 },
  { cap: fader4, x: 875, y: 158, w: 38, h: 30, top: [892, 147], bot: [896, 240] },
  { cap: fader5, x: 946, y: 162, w: 38, h: 29, top: [960, 147], bot: [972, 242] },
].map((f) => {
  // how far the cap can travel up and down from where it rests, following the track's slant
  const cy = f.y + f.h / 2;
  const slope = (f.bot[0] - f.top[0]) / (f.bot[1] - f.top[1]);
  const up = f.top[1] + f.h / 2 + 3 - cy;
  const down = f.bot[1] - f.h / 2 - 6 - cy;
  return { ...f, slope, up, down, ux: (up * slope).toFixed(1), uy: up.toFixed(1), lx: (down * slope).toFixed(1), ly: down.toFixed(1) };
});
// music notes drifting up off the two decks: across, start height, glyph, delay (s), sideways drift (px)
const notes = [
  [300, 40, '♪', 0, 30], [420, 30, '♫', 1.3, -20], [250, 60, '♫', 2.6, 24],
  [1250, 40, '♫', 0.7, -26], [1370, 30, '♪', 2, 22], [1200, 60, '♪', 3.2, -18],
];
const wash = `wash-${art}`;
// leaves dropping from the tree on the left of the church picture:
// start across (% of picture), start down (%), delay (s), fall time (s), size (px),
// sideways drift (% of picture), colour
const leafColours = ['#6f8a3a', '#9aa64a', '#55702f', '#c9a347'];
const leaves = [
  [8, 30, 0, 7.5, 20, 14, 0], [16, 22, 1.8, 8.5, 17, 22, 1], [24, 36, 3.6, 7, 19, 12, 2],
  [12, 44, 5.2, 8, 16, 18, 3], [20, 28, 6.8, 9, 20, 26, 0], [5, 40, 2.7, 7.8, 17, 16, 1],
  [27, 24, 4.4, 8.6, 16, 20, 2],
];
const stars = [
  [44, 30, 0], [86, 54, 1.1], [130, 24, 0.5], [176, 46, 1.7], [214, 22, 0.8], [262, 70, 1.4], [70, 82, 2], [292, 32, 0.3],
];
---

<div class:list={['stage-art', `stage-art--${art}`]} aria-hidden="true">
  {
    art === 'church' && (
      <div class="pic-wrap">
        <Image src={church} alt="" widths={[560, 1024]} sizes="(max-width: 700px) 80vw, 460px" class="picture" />
        <div class="leaves">
          {leaves.map(([x, y, d, t, s, drift, c]) => (
            <span class="leaf" style={`--x:${x}%;--y:${y};--d:${d}s;--t:${t}s;--s:${s}px;--drift:${drift};--c:${leafColours[c]}`}>
              <span class="sway">
                <svg class="flutter" viewBox="0 0 20 20">
                  <path d="M10 1 C16 5 17 13 10 19 C3 13 4 5 10 1 Z" style="fill: var(--c)" />
                  <path d="M10 3 V 18 M10 9 L 13.5 6.5 M10 13 L 6.5 10.5" stroke="rgba(40,50,20,0.45)" stroke-width="0.8" fill="none" stroke-linecap="round" />
                </svg>
              </span>
            </span>
          ))}
        </div>
      </div>
    )
  }

  {
    art === 'car' && (
      <div class="convoy">
        <Image src={cars} alt="" widths={[640, 1280]} sizes="(max-width: 700px) 90vw, 600px" class="picture" />
        <svg class="hubs" viewBox={`0 0 ${cars.width} ${cars.height}`} fill="none" stroke={ink} stroke-linecap="round">
          {wheels.map(([x, y, r]) => (
            <g class="hub" style={`transform-origin:${x}px ${y}px`}>
              {[0, 72, 144, 216, 288].map((a) => (
                <path d={`M${x} ${y - 8} V ${y - r + 4}`} transform={`rotate(${a} ${x} ${y})`} stroke-width="5" opacity="0.6" />
              ))}
              <circle cx={x} cy={y} r="7" fill={ink} stroke="none" opacity="0.7" />
            </g>
          ))}
        </svg>
      </div>
    )
  }

  {
    art === 'dinner' && (
      <div class="pic-wrap table" style={`aspect-ratio: ${dinner.width} / ${dinner.height}`}>
        <Image src={dinner} alt="" widths={[640, 1280]} sizes="(max-width: 700px) 90vw, 640px" class="picture" />
        <svg class="flames" viewBox={`0 0 ${dinner.width} ${dinner.height}`} aria-hidden="true">
          {candles.map(([x, y]) => (
            <g>
              <circle class="glow" cx={x} cy={y - 18} r="40" fill="#f6c453" />
              <path class="flame" d={`M${x} ${y - 44} Q ${x + 15} ${y - 16} ${x} ${y + 2} Q ${x - 15} ${y - 16} ${x} ${y - 44} Z`} fill="#ec9a2e" />
              <path class="flame" d={`M${x} ${y - 24} Q ${x + 7} ${y - 9} ${x} ${y} Q ${x - 7} ${y - 9} ${x} ${y - 24} Z`} fill="#fff1c4" />
            </g>
          ))}
        </svg>
      </div>
    )
  }

  {
    art === 'reception' && (
      <div class="pic-wrap dawa" style={`aspect-ratio: ${dawa.width} / ${dawa.height}`}>
        <Image src={dawa} alt="" widths={[320, 640]} sizes="(max-width: 700px) 70vw, 260px" class="picture" />
        <svg class="fizz" viewBox={`0 0 ${dawa.width} ${dawa.height}`} aria-hidden="true">
          {bubbles.map(([x, y, top, r, d, t]) => (
            <circle class="bubble" cx={x} cy={y} r={r} style={`--d:${d}s;--t:${t}s;--rise:${y - top}px`} />
          ))}
          {glints.map(([x, y, d]) => (
            <path class="glint" style={`--d:${d}s;transform-origin:${x}px ${y}px`} d={`M${x} ${y - 22} L ${x + 5} ${y - 5} L ${x + 22} ${y} L ${x + 5} ${y + 5} L ${x} ${y + 22} L ${x - 5} ${y + 5} L ${x - 22} ${y} L ${x - 5} ${y - 5} Z`} />
          ))}
        </svg>
      </div>
    )
  }

  {
    art === 'dance' && (
      <div class="convoy decks">
        <Image src={decks} alt="" widths={[640, 1280]} sizes="(max-width: 700px) 90vw, 600px" class="picture" />
        <svg class="grooves" viewBox={`0 0 ${decks.width} ${decks.height}`} aria-hidden="true">
          <defs>
            <filter id="fader-shadow" x="-30%" y="-30%" width="160%" height="170%">
              <feDropShadow dx="3" dy="5" stdDeviation="2.5" flood-color="#7a5a8a" flood-opacity="0.35" />
            </filter>
          </defs>
          {faders.map((f) =>
            f.t ? (
              <image class="fader" href={f.cap.src} x={f.x} y={f.y} width={f.w} height={f.h} filter="url(#fader-shadow)"
                style={`--ux:${f.ux}px;--uy:${f.uy}px;--lx:${f.lx}px;--ly:${f.ly}px;--t:${f.t}s;--d:${f.d}s`} />
            ) : (
              <image class="fader fader--drag" href={f.cap.src} x={f.x} y={f.y} width={f.w} height={f.h} filter="url(#fader-shadow)"
                data-fader data-slope={f.slope.toFixed(4)} data-up={f.up.toFixed(1)} data-down={f.down.toFixed(1)} />
            ),
          )}
          <g class="notes">
            {notes.map(([x, y, glyph, d, drift]) => (
              <text x={x} y={y} style={`--d:${d}s;--drift:${drift}px`}>{glyph}</text>
            ))}
          </g>
        </svg>
      </div>
    )
  }

  {
    art !== 'church' && art !== 'reception' && art !== 'car' && art !== 'dinner' && art !== 'dance' && (
      <svg class="drawing" viewBox="0 0 320 220" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <defs>
          <filter id={wash} x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="4" />
            <feDisplacementMap in="SourceGraphic" scale="12" />
            <feGaussianBlur stdDeviation="1.6" />
          </filter>
        </defs>

        {art === 'stars' && (
          <g>
            <g filter={`url(#${wash})`} opacity="0.55">
              <ellipse cx="160" cy="92" rx="150" ry="86" fill="#26385a" />
            </g>
            <path d="M246 44 A 18 18 0 1 0 262 74 A 14 14 0 1 1 246 44 Z" fill="#f3e9d2" />
            {stars.map(([x, y, d]) => (
              <path class="star" style={`--d:${d}s`} d={`M${x} ${y - 6} L ${x + 1.6} ${y - 1.6} L ${x + 6} ${y} L ${x + 1.6} ${y + 1.6} L ${x} ${y + 6} L ${x - 1.6} ${y + 1.6} L ${x - 6} ${y} L ${x - 1.6} ${y - 1.6} Z`} fill="#f3e9d2" />
            ))}
            <path d="M30 196 V 168 L 48 156 L 66 168 V 196 M66 196 V 174 H 104 V 196 M104 196 V 150 L 112 118 L 120 150 V 196 M120 196 V 164 L 142 150 L 164 164 V 196 M164 196 V 176 H 206 V 196 M206 196 V 160 L 226 148 L 246 160 V 196 M246 196 V 172 H 290 V 196 Z" fill="#2b2622" stroke="#2b2622" stroke-width="1" stroke-linejoin="round" />
            <rect class="window" x="44" y="176" width="8" height="10" fill="#f3d27a" />
            <rect class="window" style="--d:1.5s" x="138" y="172" width="8" height="10" fill="#f3d27a" />
            <rect class="window" style="--d:0.7s" x="222" y="172" width="8" height="10" fill="#f3d27a" />
          </g>
        )}
      </svg>
    )
  }
</div>

<script>
  // drag a fader cap up and down its track. Its travel is limited to the track, and it
  // follows the track's slant; the drag doesn't swipe the schedule along
  for (const cap of document.querySelectorAll<SVGImageElement>('[data-fader]')) {
    const svg = cap.ownerSVGElement!;
    const slope = Number(cap.dataset.slope);
    const up = Number(cap.dataset.up);
    const down = Number(cap.dataset.down);
    let at = 0;
    let startY = 0;
    let startAt = 0;
    const place = (y: number) => {
      at = Math.max(up, Math.min(down, y));
      cap.style.transform = `translate(${(at * slope).toFixed(2)}px, ${at.toFixed(2)}px)`;
    };
    cap.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      e.stopPropagation();
      cap.setPointerCapture(e.pointerId);
      cap.classList.add('is-dragging');
      startY = e.clientY;
      startAt = at;
    });
    cap.addEventListener('pointermove', (e) => {
      if (!cap.hasPointerCapture(e.pointerId)) return;
      // screen pixels to the picture's pixels
      const scale = svg.getScreenCTM()?.d || 1;
      place(startAt + (e.clientY - startY) / scale);
    });
    const end = (e: PointerEvent) => {
      if (cap.hasPointerCapture(e.pointerId)) cap.releasePointerCapture(e.pointerId);
      cap.classList.remove('is-dragging');
    };
    cap.addEventListener('pointerup', end);
    cap.addEventListener('pointercancel', end);
  }
</script>

<style>
  .stage-art {
    position: relative;
    height: clamp(170px, 30vw, 250px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .stage-art :global(.picture),
  .drawing {
    max-height: 100%;
    width: auto;
    max-width: 100%;
  }
  .drawing {
    height: 100%;
    overflow: visible;
  }

  /* church: leaves drifting down from the tree on the left. Each leaf falls (.leaf),
     swings side to side as it goes (.sway) and turns over in the air (.flutter), each
     on its own timing, so no two fall alike. Positions are shares of the picture. */
  .pic-wrap {
    position: relative;
    height: 100%;
    max-width: 100%;
    aspect-ratio: 1263 / 967;
  }
  .pic-wrap :global(.picture) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .leaves {
    position: absolute;
    inset: 0;
    container-type: size;
    pointer-events: none;
  }
  .leaf {
    position: absolute;
    left: var(--x);
    top: calc(var(--y) * 1%);
    width: var(--s);
    height: var(--s);
    opacity: 0;
    animation: leaf-fall var(--t) cubic-bezier(0.45, 0.1, 0.6, 1) var(--d) infinite;
  }
  .sway {
    display: block;
    width: 100%;
    height: 100%;
    animation: leaf-sway 2.6s ease-in-out var(--d) infinite alternate;
  }
  .flutter {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: leaf-flutter 2.2s ease-in-out var(--d) infinite;
  }
  @keyframes leaf-fall {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    10% {
      opacity: 0.95;
    }
    85% {
      opacity: 0.9;
    }
    100% {
      /* down to the grass at the foot of the picture */
      transform: translate(calc(var(--drift) * 1cqw), calc((94 - var(--y)) * 1cqh));
      opacity: 0;
    }
  }
  @keyframes leaf-sway {
    from {
      transform: translateX(-12px) rotate(-30deg);
    }
    to {
      transform: translateX(12px) rotate(34deg);
    }
  }
  @keyframes leaf-flutter {
    0%,
    100% {
      transform: rotateY(-55deg) rotateX(14deg);
    }
    50% {
      transform: rotateY(55deg) rotateX(-14deg);
    }
  }

  /* reception: a dawa and a spritz clinking, their drinks fizzing, bubbles rising to the top and the salt
     on the rim catching the light now and then */
  .fizz {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .bubble {
    fill: rgba(255, 255, 255, 0.55);
    stroke: rgba(255, 255, 255, 0.95);
    stroke-width: 4;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: bubble-rise var(--t) cubic-bezier(0.4, 0, 0.8, 1) var(--d) infinite;
  }
  @keyframes bubble-rise {
    0% {
      transform: translate(0, 0) scale(0.6);
      opacity: 0;
    }
    15% {
      opacity: 0.95;
    }
    50% {
      transform: translate(6px, calc(var(--rise) * -0.5)) scale(0.9);
    }
    85% {
      opacity: 0.9;
    }
    100% {
      transform: translate(-4px, calc(var(--rise) * -1)) scale(1.1);
      opacity: 0;
    }
  }
  .glint {
    fill: #fff;
    opacity: 0;
    animation: glint 3.2s ease-in-out var(--d) infinite;
  }
  @keyframes glint {
    0%,
    70%,
    100% {
      opacity: 0;
      transform: scale(0.3) rotate(0deg);
    }
    82% {
      opacity: 1;
      transform: scale(1) rotate(45deg);
    }
  }

  /* car: the convoy standing still, wheels turning; its white backdrop melts into the paper */
  .convoy {
    position: relative;
    width: 100%;
    max-width: 600px;
    align-self: flex-end;
  }
  .convoy :global(.picture) {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    mix-blend-mode: multiply;
  }
  .hubs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hub {
    animation: spin 1.4s linear infinite;
  }

  /* dinner: the long table, its candles lit and flickering; the picture's white
     backdrop melts into the paper */
  .table {
    max-width: 640px;
    height: auto;
    width: 100%;
    /* sit on the bottom of the space, like the other pictures */
    align-self: flex-end;
  }
  .table :global(.picture) {
    mix-blend-mode: multiply;
  }
  .flames {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .glow {
    opacity: 0.22;
    filter: blur(6px);
    animation: glow 1.7s ease-in-out infinite alternate;
  }
  @keyframes glow {
    to {
      opacity: 0.12;
    }
  }
  .flame {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: flicker 1.3s ease-in-out infinite alternate;
  }
  g:nth-child(2n) .flame {
    animation-duration: 1.1s;
  }
  @keyframes flicker {
    0% {
      transform: scale(1, 1) rotate(-3deg);
    }
    50% {
      transform: scale(0.85, 1.15) rotate(2deg);
    }
    100% {
      transform: scale(1.05, 0.9) rotate(-1deg);
      opacity: 0.85;
    }
  }

  /* dance: the decks, a few faders on the mixer sliding up and down, and music notes
     drifting up off them */
  .fader:not(.fader--drag) {
    animation: fader var(--t) ease-in-out var(--d) infinite;
  }
  /* the ones you can push about yourself */
  .fader--drag {
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
  }
  .fader--drag.is-dragging {
    cursor: grabbing;
  }
  @keyframes fader {
    /* mostly resting; every so often a quick push up, pull down and back */
    0%,
    72%,
    100% {
      transform: translate(0, 0);
    }
    79% {
      transform: translate(var(--ux), var(--uy));
    }
    88% {
      transform: translate(var(--lx), var(--ly));
    }
  }
  .grooves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .notes text {
    font: 64px serif;
    fill: #4b3618;
    opacity: 0;
    animation: float 4.2s ease-out infinite var(--d);
  }
  @keyframes float {
    0% {
      transform: translate(0, 10px);
      opacity: 0;
    }
    20% {
      opacity: 0.85;
    }
    100% {
      transform: translate(var(--drift), -190px) rotate(8deg);
      opacity: 0;
    }
  }

  /* stars: twinkling over the village, a few windows still lit */
  .star {
    transform-box: fill-box;
    transform-origin: center;
    animation: sparkle 2.4s ease-in-out infinite var(--d);
  }
  @keyframes sparkle {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.5);
      opacity: 0.4;
    }
  }
  .window {
    animation: lamp 4s ease-in-out infinite var(--d, 0s);
  }
  @keyframes lamp {
    0%,
    70%,
    100% {
      opacity: 1;
    }
    80%,
    90% {
      opacity: 0.25;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
