---
// The illustration for one schedule stage, with a small looping animation.
// 'church' and 'reception' use the real watercolours; the others are hand-drawn
// placeholders in the same washed style until matching watercolours are made
// (see CONTENT_TODO.md). Animations pause on stages that aren't showing and are
// switched off for people who prefer reduced motion.
import { Image } from 'astro:assets';
import church from '../assets/illus-church.png';
import recatadou from '../assets/illus-recatadou.png';
import type { StageArt } from '../content';

interface Props {
  art: StageArt;
}
const { art } = Astro.props;
const ink = '#5a5a52';
const wash = `wash-${art}`;
// confetti pieces: horizontal position (%), delay (s), duration (s), size (px)
const confetti = [
  [8, 0, 5.5, 9], [18, 1.6, 6.2, 7], [27, 0.7, 5, 10], [38, 2.4, 6.6, 8], [47, 0.2, 5.8, 9],
  [58, 1.9, 6, 7], [66, 0.9, 5.2, 10], [75, 2.8, 6.4, 8], [84, 1.2, 5.6, 9], [93, 0.4, 6.1, 7],
];
const stars = [
  [44, 30, 0], [86, 54, 1.1], [130, 24, 0.5], [176, 46, 1.7], [214, 22, 0.8], [262, 70, 1.4], [70, 82, 2], [292, 32, 0.3],
];
const bulbs = [
  [41.6, 56.4], [72.4, 65.6], [102.4, 67.6], [131.6, 62.4], [188.4, 62.4], [217.6, 67.6], [247.6, 65.6], [278.4, 56.4],
];
---

<div class:list={['stage-art', `stage-art--${art}`]} aria-hidden="true">
  {
    art === 'church' && (
      <>
        <Image src={church} alt="" widths={[560, 1024]} sizes="(max-width: 700px) 80vw, 460px" class="picture" />
        <div class="confetti">
          {confetti.map(([x, d, t, s]) => (
            <i style={`--x:${x}%;--d:${d}s;--t:${t}s;--s:${s}px`} />
          ))}
        </div>
      </>
    )
  }

  {
    art === 'reception' && (
      <>
        <Image src={recatadou} alt="" widths={[480, 960]} sizes="(max-width: 700px) 70vw, 340px" class="picture" />
        <svg class="coupes" viewBox="0 0 120 120" fill="none" stroke={ink} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <g class="bubbles" fill="#e8c88f" stroke="none">
            <circle cx="44" cy="40" r="2.6" style="--d:0s" />
            <circle cx="60" cy="36" r="2" style="--d:0.8s" />
            <circle cx="74" cy="42" r="2.4" style="--d:1.5s" />
            <circle cx="52" cy="44" r="1.8" style="--d:2.1s" />
          </g>
          <g class="coupe coupe--left">
            <path d="M22 58 Q 40 74 58 58 Z" fill="#f3e2b0" />
            <path d="M40 66 V 96 M30 98 H 50" />
          </g>
          <g class="coupe coupe--right">
            <path d="M62 58 Q 80 74 98 58 Z" fill="#f3e2b0" />
            <path d="M80 66 V 96 M70 98 H 90" />
          </g>
        </svg>
      </>
    )
  }

  {
    art !== 'church' && art !== 'reception' && (
      <svg class="drawing" viewBox="0 0 320 220" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <defs>
          <filter id={wash} x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="4" />
            <feDisplacementMap in="SourceGraphic" scale="12" />
            <feGaussianBlur stdDeviation="1.6" />
          </filter>
        </defs>

        {art === 'car' && (
          <g>
            <g filter={`url(#${wash})`} opacity="0.5">
              <circle cx="262" cy="50" r="22" fill="#e8c88f" />
              <ellipse cx="80" cy="190" rx="140" ry="38" fill="#a9b98c" />
              <ellipse cx="262" cy="196" rx="120" ry="32" fill="#c9d4a8" />
            </g>
            <g stroke={ink} stroke-width="1.6">
              <path d="M0 196 C 80 178, 200 214, 320 192" />
              <path d="M0 206 C 80 190, 200 224, 320 202" stroke-dasharray="6 10" opacity="0.5" />
              <path class="whoosh" d="M28 132 H 52 M20 146 H 48 M32 158 H 54" opacity="0.6" />
            </g>
            <g class="car">
              <path d="M70 160 Q 72 128 110 120 Q 150 104 196 112 Q 226 118 236 140 L 244 150 Q 248 160 240 166 L 76 166 Q 68 166 70 160 Z" fill="#8c9d6a" opacity="0.55" filter={`url(#${wash})`} />
              <g stroke={ink} stroke-width="1.8">
                <path d="M70 160 Q 72 128 110 120 Q 150 104 196 112 Q 226 118 236 140 L 244 150 Q 248 160 240 166 L 76 166 Q 68 166 70 160 Z" />
                <path d="M114 124 Q 150 112 190 117 L 198 140 L 110 140 Z" fill="#dbe6f0" />
                <path d="M152 115 V 140 M152 140 V 160 M110 140 Q 108 152 112 160" />
                <circle cx="238" cy="149" r="5" fill="#f3e2b0" />
              </g>
              <g class="wheel" stroke={ink} stroke-width="1.8">
                <circle cx="110" cy="166" r="14" fill="#fff" />
                <circle cx="110" cy="166" r="4" />
                <path d="M110 152 V 180 M96 166 H 124" />
              </g>
              <g class="wheel" stroke={ink} stroke-width="1.8">
                <circle cx="206" cy="166" r="14" fill="#fff" />
                <circle cx="206" cy="166" r="4" />
                <path d="M206 152 V 180 M192 166 H 220" />
              </g>
            </g>
          </g>
        )}

        {art === 'dinner' && (
          <g>
            <g filter={`url(#${wash})`} opacity="0.55">
              <ellipse cx="160" cy="50" rx="92" ry="40" fill="#8c9d6a" />
              <ellipse cx="112" cy="58" rx="46" ry="28" fill="#a9b98c" />
              <ellipse cx="208" cy="58" rx="46" ry="28" fill="#a9b98c" />
              <rect x="36" y="128" width="248" height="44" rx="4" fill="#efe6cf" />
            </g>
            <g stroke={ink} stroke-width="1.6">
              <path d="M160 128 V 82 M160 100 Q 146 88 128 80 M160 94 Q 174 82 194 76" stroke-width="2.4" />
              <path d="M84 60 Q 100 26 160 22 Q 220 26 236 60 Q 226 82 196 84 Q 176 92 160 86 Q 144 92 124 84 Q 94 82 84 60 Z" opacity="0.7" />
              <path d="M30 128 H 290" stroke-width="2" />
              <path d="M36 128 Q 40 150 36 172 Q 100 166 160 172 Q 220 166 284 172 Q 280 150 284 128" />
              <path d="M60 172 V 196 M260 172 V 196" stroke-width="2" />
              {[70, 118, 202, 250].map((x) => (
                <ellipse cx={x} cy="125" rx="13" ry="3.5" fill="#fff" />
              ))}
              {[94, 160, 226].map((x) => (
                <g>
                  <rect x={x - 3} y="100" width="6" height="25" fill="#f4f1e4" />
                  <path class="flame" d={`M${x} 86 Q ${x + 5} 94 ${x} 98 Q ${x - 5} 94 ${x} 86 Z`} fill="#e8a948" stroke="none" />
                </g>
              ))}
            </g>
          </g>
        )}

        {art === 'dance' && (
          <g>
            <g filter={`url(#${wash})`} opacity="0.5">
              <rect x="96" y="132" width="128" height="56" rx="6" fill="#c9a77a" />
              <circle cx="250" cy="120" r="30" fill="#e6d5b8" />
            </g>
            <g stroke={ink} stroke-width="1.6">
              <path d="M10 40 Q 90 90 160 50 Q 230 90 310 40" />
              {bulbs.map(([x, y], i) => (
                <g>
                  <path d={`M${x} ${y} V ${y + 6}`} />
                  <circle class="bulb" cx={x} cy={y + 12} r="6" fill="#f3d27a" style={`--d:${(i % 4) * 0.35}s`} />
                </g>
              ))}
              <rect x="96" y="132" width="128" height="56" rx="6" />
              <g class="record">
                <circle cx="152" cy="158" r="22" fill="#2b2622" />
                <circle cx="152" cy="158" r="15" stroke="#6a625a" />
                <circle cx="152" cy="158" r="6" fill="var(--flag-accent, #b3472f)" stroke="none" />
                <path d="M152 140 Q 160 146 162 154" stroke="#8a8278" />
              </g>
              <path d="M206 142 L 190 150 L 178 156" stroke-width="2.2" />
              <circle cx="206" cy="142" r="4" fill="#fff" />
            </g>
            <g class="notes" fill={ink} font-size="22" font-family="serif">
              <text x="232" y="120" style="--d:0s">♪</text>
              <text x="252" y="104" style="--d:1.2s">♫</text>
              <text x="226" y="96" style="--d:2.4s">♪</text>
            </g>
          </g>
        )}

        {art === 'stars' && (
          <g>
            <g filter={`url(#${wash})`} opacity="0.55">
              <ellipse cx="160" cy="92" rx="150" ry="86" fill="#26385a" />
            </g>
            <path d="M246 44 A 18 18 0 1 0 262 74 A 14 14 0 1 1 246 44 Z" fill="#f3e9d2" />
            {stars.map(([x, y, d]) => (
              <path class="star" style={`--d:${d}s`} d={`M${x} ${y - 6} L ${x + 1.6} ${y - 1.6} L ${x + 6} ${y} L ${x + 1.6} ${y + 1.6} L ${x} ${y + 6} L ${x - 1.6} ${y + 1.6} L ${x - 6} ${y} L ${x - 1.6} ${y - 1.6} Z`} fill="#f3e9d2" />
            ))}
            <path d="M30 196 V 168 L 48 156 L 66 168 V 196 M66 196 V 174 H 104 V 196 M104 196 V 150 L 112 118 L 120 150 V 196 M120 196 V 164 L 142 150 L 164 164 V 196 M164 196 V 176 H 206 V 196 M206 196 V 160 L 226 148 L 246 160 V 196 M246 196 V 172 H 290 V 196 Z" fill="#2b2622" stroke="#2b2622" stroke-width="1" stroke-linejoin="round" />
            <rect class="window" x="44" y="176" width="8" height="10" fill="#f3d27a" />
            <rect class="window" style="--d:1.5s" x="138" y="172" width="8" height="10" fill="#f3d27a" />
            <rect class="window" style="--d:0.7s" x="222" y="172" width="8" height="10" fill="#f3d27a" />
          </g>
        )}
      </svg>
    )
  }
</div>

<style>
  .stage-art {
    position: relative;
    height: clamp(170px, 30vw, 250px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .stage-art :global(.picture),
  .drawing {
    max-height: 100%;
    width: auto;
    max-width: 100%;
  }
  .drawing {
    height: 100%;
    overflow: visible;
  }

  /* church: confetti in the flag colours, falling past the spire */
  .confetti {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .confetti i {
    position: absolute;
    top: -12px;
    left: var(--x);
    width: var(--s);
    height: calc(var(--s) * 0.7);
    background: var(--c, #b3472f);
    animation: fall var(--t) linear var(--d) infinite;
    opacity: 0;
  }
  :global([data-flag='en']) .confetti i:nth-child(3n + 1) {
    --c: var(--ke-black);
  }
  :global([data-flag='en']) .confetti i:nth-child(3n + 2) {
    --c: var(--ke-red);
  }
  :global([data-flag='en']) .confetti i:nth-child(3n) {
    --c: var(--ke-green);
  }
  :global([data-flag='fr']) .confetti i:nth-child(3n + 1) {
    --c: var(--fr-blue-ink);
  }
  :global([data-flag='fr']) .confetti i:nth-child(3n + 2) {
    --c: var(--fr-red);
  }
  :global([data-flag='fr']) .confetti i:nth-child(3n) {
    --c: var(--fr-blue);
  }
  @keyframes fall {
    0% {
      transform: translateY(0) rotate(0deg);
      opacity: 0;
    }
    8% {
      opacity: 0.9;
    }
    100% {
      transform: translateY(260px) rotate(540deg);
      opacity: 0;
    }
  }

  /* reception: two coupes clinking, bubbles rising */
  .coupes {
    position: absolute;
    left: 4%;
    bottom: 0;
    width: clamp(84px, 16vw, 128px);
    overflow: visible;
  }
  .coupe {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: clink 2.4s ease-in-out infinite;
  }
  .coupe--left {
    --lean: 9deg;
  }
  .coupe--right {
    --lean: -9deg;
  }
  @keyframes clink {
    0%,
    100% {
      transform: rotate(0deg);
    }
    40%,
    50% {
      transform: rotate(var(--lean));
    }
  }
  .bubbles circle {
    animation: rise 2.6s ease-in infinite var(--d);
    opacity: 0;
  }
  @keyframes rise {
    0% {
      transform: translateY(14px);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      transform: translateY(-30px);
      opacity: 0;
    }
  }

  /* car: bobbing along, wheels turning */
  .car {
    animation: bob 0.45s ease-in-out infinite alternate;
  }
  @keyframes bob {
    to {
      transform: translateY(-2.5px);
    }
  }
  .wheel {
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 0.9s linear infinite;
  }
  .whoosh {
    animation: whoosh 0.9s ease-in-out infinite alternate;
  }
  @keyframes whoosh {
    from {
      transform: translateX(6px);
      opacity: 0.2;
    }
  }

  /* dinner: candle flames flickering */
  .flame {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: flicker 1.3s ease-in-out infinite alternate;
  }
  .flame:nth-of-type(2n) {
    animation-duration: 1.1s;
  }
  @keyframes flicker {
    0% {
      transform: scale(1, 1) rotate(-3deg);
    }
    50% {
      transform: scale(0.85, 1.15) rotate(2deg);
    }
    100% {
      transform: scale(1.05, 0.9) rotate(-1deg);
      opacity: 0.85;
    }
  }

  /* dance: festoon lights twinkling, record spinning, notes floating up */
  .bulb {
    animation: twinkle 1.6s ease-in-out infinite alternate var(--d);
  }
  @keyframes twinkle {
    from {
      fill: #f3d27a;
    }
    to {
      fill: #fff4cf;
      opacity: 0.6;
    }
  }
  .record {
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 3s linear infinite;
  }
  .notes text {
    animation: float 3.6s ease-out infinite var(--d);
    opacity: 0;
  }
  @keyframes float {
    0% {
      transform: translate(0, 10px);
      opacity: 0;
    }
    25% {
      opacity: 0.9;
    }
    100% {
      transform: translate(14px, -34px);
      opacity: 0;
    }
  }

  /* stars: twinkling over the village, a few windows still lit */
  .star {
    transform-box: fill-box;
    transform-origin: center;
    animation: sparkle 2.4s ease-in-out infinite var(--d);
  }
  @keyframes sparkle {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.5);
      opacity: 0.4;
    }
  }
  .window {
    animation: lamp 4s ease-in-out infinite var(--d, 0s);
  }
  @keyframes lamp {
    0%,
    70%,
    100% {
      opacity: 1;
    }
    80%,
    90% {
      opacity: 0.25;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
