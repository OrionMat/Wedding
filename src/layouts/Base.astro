---
import '../styles/global.css';
import RsvpDialog from '../components/RsvpDialog.astro';
import { getImage } from 'astro:assets';
import ogSource from '../assets/save-the-date-intro.jpg';
import { languages, routes, href, parsePath, type Lang } from '../i18n';
import { t } from '../content';

interface Props {
  lang: Lang;
  title?: string;
  /** false on the home page, where paper cards on the letter do the navigating */
  pageLinks?: boolean;
}

const { lang, title, pageLinks = true } = Astro.props;
const c = t(lang);
const { route } = parsePath(Astro.url.pathname);
// the top-left pill links to every page except the one you're on
const otherRoutes = routes.filter((r) => r !== route);
const fullTitle = title ? `${title} · ${c.names}` : c.names;
const og = await getImage({ src: ogSource, width: 900, format: 'jpg' });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={c.meta.description} />
    <meta name="theme-color" content="#fdfbf7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta property="og:type" content="website" />
    {
      Object.keys(languages).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(href(l as Lang, route), Astro.site)} />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caudex:ital,wght@0,400;0,700;1,400&family=Germania+One&family=Libre+Caslon+Text:wght@600&family=Public+Sans:wght@400;500&display=swap"
    />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@700&text=Vv&display=swap" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      {
        pageLinks && (
          <nav class="switch pages" aria-label={c.nav.menu}>
            {otherRoutes.map((r) => (
              <a href={href(lang, r)}>{c.nav.pages[r]}</a>
            ))}
          </nav>
        )
      }

      <nav class="switch langs" aria-label="Language">
        {
          Object.entries(languages).map(([code, label]) => (
            <a
              href={href(code as Lang, route)}
              lang={code}
              hreflang={code}
              aria-current={code === lang ? 'true' : undefined}
            >
              {label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <RsvpDialog lang={lang} />

    <script>
      // Fade-up on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 100;
    padding: 8px 14px;
    background: var(--color-ink);
    color: var(--color-on-ink);
    border-radius: var(--radius-pill);
  }
  .skip:focus {
    left: 16px;
  }

  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 16px var(--gutter);
    pointer-events: none;
  }
  .topbar > * {
    pointer-events: auto;
  }

  /* small pills in the top bar: page links on the left, language on the right */
  .switch {
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(6px);
    /* faint edge so the pills still read on the plain cream pages */
    box-shadow: 0 0 0 1px rgba(75, 54, 24, 0.1), 0 4px 14px rgba(44, 44, 44, 0.1);
  }
  .switch a {
    font-family: var(--font-headline);
    font-size: 16px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 7px 11px 6px;
    border-radius: var(--radius-pill);
    color: var(--color-headline);
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  @media (max-width: 420px) {
    .topbar {
      gap: 8px;
    }
    .switch a {
      font-size: 14px;
      padding: 7px 9px 6px;
    }
  }
  .switch a:hover {
    background: rgba(75, 54, 24, 0.1);
  }
  .pages {
    grid-column: 1;
    justify-self: start;
  }
  .langs {
    grid-column: 2;
    justify-self: end;
  }
  /* the language you're not reading is greyed; the current one is highlighted */
  .langs a {
    color: rgba(75, 54, 24, 0.55);
  }
  .langs a[aria-current] {
    color: var(--color-headline);
    background: rgba(75, 54, 24, 0.1);
  }
</style>
